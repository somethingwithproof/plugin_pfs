msgstr "Biểu đồ của hệ thống tệp này"

#: lib/TargetsPage.php
msgid "Condition"
msgstr "Điều kiện"

#: lib/TargetsPage.php
msgid "Freshness"
msgstr "Độ mới"

#: lib/TargetsPage.php
msgid "Known Values"
msgstr "Giá trị đã biết"

#: lib/TargetsPage.php
msgid "Last Seen"
msgstr "Thấy lần cuối"

#: lib/TargetsPage.php
msgid "Recovery"
msgstr "Khôi phục"

#: lib/TargetsPage.php

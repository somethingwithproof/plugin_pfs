#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: noodhku wuxuu ku jawaabay qaab aan lahayn qaab-dhismeedka go'an ee qoraalka akhriska. Waxaa laga yaabaa in furihiisu uusan ku xaddidnayn amar qasab ah oo wada pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: furaha martigeliyaha noodhku kuma jiro faylka martigeliyayaasha la yaqaan, ama wuu isbeddelay. Hubi furaha ka hor intaadan ku darin."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: barta dhamaadku waxay u xallismaa meel ka baxsan shabakadaha loo oggol yahay poller %d, sidaas darteed lama akhriyo."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: qoraalka akhrisku wuxuu daabacay %d cabbir oo uusan plugin-ku akhriyin, sidaas darteed ma aha pfs-read.sh-kii la soo diray. Waxaa laga yaabaa in noodhku soo bandhigayo wax ka badan inta uu plugin-ku u baahan yahay."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d magac bartilmaameed oo ku jiray soo-saarka noodhka kuma habboonayn qaabka la filayo ama nidaamka faylalka waana la iska dhaafay."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Akhriyaha ku jira poller %d ma dhammaystirin hal socod %d ilbiriqsi ee ugu dambeeyay. Qiimayaasha ka imaanaya noodhyadiisa waxay noqonayaan kuwo duugoobay."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Rakibidda qaab-dhismeedyada Parallel Filesystem way fashilantay: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Qaab-dhismeedyada Parallel Filesystem lama rakibin, sidaas darteed wax qalab ah laguma dari karo."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Faylka weydiinta xogta resource/script_server/%s waa ka maqan yahay Cacti ama wuu ka duwan yahay kan uu plugin-kan soo diro, sidaas darteed weydimaha xogtu ma tixi karaan bartilmaameedyada."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Nidaamka faylalka %s wuxuu ku xidhan yahay qalabka %d, kaas oo aan hadda jirin."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Qalabka nidaamka faylalka %s waxaa soo ururiya poller %d, laakiin noodhyadiisa waxaa akhriya poller %d, kaas oo ilaha xogta qalabku u baahan yihiin kaydkiisa."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Faylka furaha SSH %s kama jiro server-kan."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Faylka furaha SSH %s waxaa akhrin kara ama qori kara isticmaalayaal aan ahayn milkiilihiisa (habka %s). Ku xaddid isticmaalaha poller-ka."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Faylka martigeliyayaasha la yaqaan %s kama jiro server-kan, sidaas darteed wax noodh ah lagama akhrin karo."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "Macmiilka SSH %s kama jiro server-kan."


#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: nod menjawab tanpa pemformatan skrip bacaan tetap. Kuncinya mungkin tidak dihadkan kepada perintah paksa yang menjalankan pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: kunci hos nod tiada dalam fail hos diketahui, atau ia telah berubah. Semak kunci sebelum menambahkannya."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: titik akhir diselesaikan di luar rangkaian yang dibenarkan untuk peninjau %d, jadi ia tidak dibaca."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: skrip bacaan mencetak %d parameter yang tidak dibaca oleh pemalam, jadi ia bukan pfs-read.sh yang dibekalkan. Nod mungkin mendedahkan lebih daripada yang diperlukan pemalam."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d nama sasaran dalam output nod tidak sepadan dengan corak atau sistem fail yang dijangka dan telah diabaikan."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Pembaca pada peninjau %d tidak menyelesaikan larian dalam %d saat yang lalu. Nilai daripada nodnya semakin lapuk."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Pemasangan templat Parallel Filesystem gagal: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Templat Parallel Filesystem tidak dipasang, jadi tiada peranti boleh ditambah."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Fail pertanyaan data resource/script_server/%s tiada daripada Cacti atau berbeza daripada yang dibekalkan oleh pemalam ini, jadi pertanyaan data tidak dapat menyenaraikan sasaran."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Sistem fail %s dipetakan kepada peranti %d, yang tidak lagi wujud."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Peranti sistem fail %s ditinjau oleh peninjau %d, tetapi nodnya dibaca oleh peninjau %d, yang cache-nya diperlukan oleh sumber data peranti tersebut."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Fail kunci SSH %s tidak wujud pada pelayan ini."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Fail kunci SSH %s boleh dibaca atau ditulis oleh pengguna selain pemiliknya (mod %s). Hadkannya kepada pengguna peninjau."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Fail hos diketahui %s tidak wujud pada pelayan ini, jadi tiada nod boleh dibaca daripadanya."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "Klien SSH %s tidak wujud pada pelayan ini."

#: lib/NodeInput.php
msgid "Filesystem: choose one of the registered filesystems."
msgstr "Sistem Fail: pilih salah satu sistem fail yang didaftarkan."

#: lib/NodeInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Nama: gunakan 1 hingga 64 huruf, digit, titik, sempang atau garis bawah, bermula dengan huruf atau digit."

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "Peranan: pilih salah satu peranan yang disenaraikan."

#: lib/NodeInput.php
msgid "Port: enter a port from 1 to 65535."
msgstr "Port: masukkan port dari 1 hingga 65535."

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "Nama Log Masuk: gunakan nama akaun huruf kecil tidak lebih daripada 32 aksara, bermula dengan huruf atau garis bawah."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "Titik Akhir: masukkan nama hos atau alamat IP sahaja, tanpa pengguna, port atau laluan."

#: lib/NodeInput.php
msgid "Endpoint: the name does not resolve on this server."
msgstr "Titik Akhir: nama tersebut tidak dapat diselesaikan pada pelayan ini."

#: lib/NodeInput.php
#, php-format
msgid "Endpoint: it resolves to %s, which is not inside the networks allowed for this poller. Add the network first."
msgstr "Titik Akhir: ia diselesaikan kepada %s, yang tiada dalam rangkaian yang dibenarkan untuk peninjau ini. Tambah rangkaian terlebih dahulu."


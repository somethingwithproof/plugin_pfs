#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: ο κόμβος απάντησε χωρίς το σταθερό πλαίσιο του σεναρίου ανάγνωσης. Το κλειδί του ενδέχεται να μην περιορίζεται σε υποχρεωτική εντολή που εκτελεί το pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: το κλειδί κεντρικού υπολογιστή του κόμβου δεν βρίσκεται στο αρχείο γνωστών κεντρικών υπολογιστών ή έχει αλλάξει. Ελέγξτε το κλειδί πριν το προσθέσετε."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: το τελικό σημείο επιλύεται εκτός των δικτύων που επιτρέπονται για τον poller %d, επομένως δεν αναγιγνώσκεται."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: το σενάριο ανάγνωσης εκτύπωσε %d παραμέτρους που δεν διαβάζει το πρόσθετο, επομένως δεν είναι το παρεχόμενο pfs-read.sh. Ο κόμβος ενδέχεται να εκθέτει περισσότερα δεδομένα από όσα χρειάζεται το πρόσθετο."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d ονόματα στόχων στην έξοδο του κόμβου δεν ταίριαζαν με το αναμενόμενο μοτίβο ή σύστημα αρχείων και αγνοήθηκαν."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Ο αναγνώστης στον poller %d δεν έχει ολοκληρώσει εκτέλεση τα τελευταία %d δευτερόλεπτα. Οι τιμές από τους κόμβους του καθίστανται παρωχημένες."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Η εγκατάσταση των προτύπων Parallel Filesystem απέτυχε: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Τα πρότυπα Parallel Filesystem δεν είναι εγκατεστημένα, επομένως δεν μπορεί να προστεθεί συσκευή."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Το αρχείο ερωτήματος δεδομένων resource/script_server/%s λείπει από το Cacti ή διαφέρει από αυτό που παρέχει το πρόσθετο, επομένως τα ερωτήματα δεδομένων δεν μπορούν να παραθέσουν στόχους."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Το σύστημα αρχείων %s έχει αντιστοιχιστεί στη συσκευή %d, η οποία δεν υπάρχει πλέον."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Η συσκευή του συστήματος αρχείων %s συλλέγεται από τον poller %d, αλλά οι κόμβοι του διαβάζονται από τον poller %d, την προσωρινή μνήμη του οποίου χρειάζονται οι πηγές δεδομένων της συσκευής."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Το αρχείο κλειδιού SSH %s δεν υπάρχει σε αυτόν τον διακομιστή."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Το αρχείο κλειδιού SSH %s μπορεί να αναγνωστεί ή να τροποποιηθεί από χρήστες άλλους από τον κάτοχό του (δικαιώματα %s). Περιορίστε το στον χρήστη του poller."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Το αρχείο γνωστών κεντρικών υπολογιστών %s δεν υπάρχει σε αυτόν τον διακομιστή, επομένως δεν μπορεί να αναγνωστεί κανένας κόμβος από αυτόν."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "Ο πελάτης SSH %s δεν υπάρχει σε αυτόν τον διακομιστή."

#: lib/NodeInput.php
msgid "Filesystem: choose one of the registered filesystems."
msgstr "Σύστημα αρχείων: επιλέξτε ένα από τα καταχωρημένα συστήματα αρχείων."

#: lib/NodeInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Όνομα: χρησιμοποιήστε 1 έως 64 γράμματα, ψηφία, τελείες, παύλες ή κάτω παύλες, ξεκινώντας με γράμμα ή ψηφίο."

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "Ρόλος: επιλέξτε έναν από τους αναγραφόμενους ρόλους."

#: lib/NodeInput.php
msgid "Port: enter a port from 1 to 65535."
msgstr "Θύρα: εισαγάγετε μια θύρα από 1 έως 65535."

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "Όνομα σύνδεσης: χρησιμοποιήστε όνομα λογαριασμού με πεζούς χαρακτήρες έως 32 χαρακτήρων, που ξεκινά με γράμμα ή κάτω παύλα."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "Τελικό σημείο: εισαγάγετε μόνο όνομα κεντρικού υπολογιστή ή διεύθυνση IP, χωρίς χρήστη, θύρα ή διαδρομή."

#: lib/NodeInput.php
msgid "Endpoint: the name does not resolve on this server."
msgstr "Τελικό σημείο: το όνομα δεν επιλύεται σε αυτόν τον διακομιστή."

#: lib/NodeInput.php
#, php-format
msgid "Endpoint: it resolves to %s, which is not inside the networks allowed for this poller. Add the network first."
msgstr "Τελικό σημείο: επιλύεται σε %s, το οποίο δεν ανήκει στα δίκτυα που επιτρέπονται για αυτόν τον poller. Προσθέστε πρώτα το δίκτυο."


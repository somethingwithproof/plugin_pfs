msgstr "Loo rekhodi yeyesixhobo se-Cacti ongenamvume yaso. Akukho nto itshintshiweyo."

#: pfs_admin.php
msgid "Name: another filesystem of this backend already uses this name."
msgstr "Igama: enye inkqubo yeefayile yale backend sele isebenzisa eli gama."


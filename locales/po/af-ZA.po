#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: die nodus het sonder die vaste leesskripraamwerk geantwoord. Sy sleutel is moontlik nie beperk tot 'n gedwonge opdrag wat pfs-read.sh uitvoer nie."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: die nodus se gasheersleutel is nie in die bekende-gashere-lêer nie, of dit het verander. Kontroleer die sleutel voordat dit bygevoeg word."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: die eindpunt los op buite die netwerke wat vir poller %d toegelaat word, dus word dit nie gelees nie."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: die leesskrip het %d parameters gedruk wat die inprop nie lees nie, dus is dit nie die meegeleverde pfs-read.sh nie. Die nodus stel moontlik meer bloot as wat die inprop nodig het."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d teikenname in die nodusafvoer het nie met die verwagte patroon of lêerstelsel ooreengestem nie en is geïgnoreer."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Die leser op poller %d het nie in die laaste %d sekondes 'n lopie voltooi nie. Waardes vanaf sy nodusse raak verouderd."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Die installering van die Parallel Filesystem-sjablone het misluk: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Die Parallel Filesystem-sjablone is nie geïnstalleer nie, dus kan geen toestel bygevoeg word nie."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Die datanavraaglêer resource/script_server/%s ontbreek in Cacti of verskil van die een wat hierdie inprop meelewer, dus kan die datanavrae nie teikens lys nie."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Lêerstelsel %s is gekoppel aan toestel %d, wat nie meer bestaan nie."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Die toestel van lêerstelsel %s word deur poller %d gepol, maar sy nodusse word deur poller %d gelees, wie se kas die toestel se databronne nodig het."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Die SSH-sleutellêer %s bestaan nie op hierdie bediener nie."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Die SSH-sleutellêer %s kan deur ander gebruikers as die eienaar gelees of geskryf word (modus %s). Beperk dit tot die poller-gebruiker."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Die bekende-gashere-lêer %s bestaan nie op hierdie bediener nie, dus kan geen nodus daaruit gelees word nie."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "Die SSH-kliënt %s bestaan nie op hierdie bediener nie."


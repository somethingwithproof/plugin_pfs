msgstr "Grafovi ovog datotečnog sustava"

#: lib/TargetsPage.php
msgid "Condition"
msgstr "Uvjet"

#: lib/TargetsPage.php
msgid "Freshness"
msgstr "Ažurnost"

#: lib/TargetsPage.php
msgid "Known Values"
msgstr "Poznate vrijednosti"

#: lib/TargetsPage.php
msgid "Last Seen"
msgstr "Zadnji put viđeno"

#: lib/TargetsPage.php
msgid "Recovery"
msgstr "Oporavak"

#: lib/TargetsPage.php

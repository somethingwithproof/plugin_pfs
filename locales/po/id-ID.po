msgstr "Sistem Berkas: pilih salah satu sistem berkas yang terdaftar."

#: lib/NodeInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Nama: gunakan 1 hingga 64 huruf, angka, titik, tanda hubung, atau garis bawah, dimulai dengan huruf atau angka."

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "Peran: pilih salah satu peran yang tercantum."

#: lib/NodeInput.php
msgid "Port: enter a port from 1 to 65535."
msgstr "Port: masukkan port dari 1 hingga 65535."

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "Nama Login: gunakan nama akun huruf kecil dengan panjang maksimal 32 karakter, diawali dengan huruf atau garis bawah."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "Titik Akhir: masukkan nama host atau alamat IP saja, tanpa pengguna, port, atau jalur."

#: lib/NodeInput.php
msgid "Endpoint: the name does not resolve on this server."
msgstr "Titik Akhir: nama tidak dapat diresolusi di server ini."

#: lib/NodeInput.php
#, php-format
msgid "Endpoint: it resolves to %s, which is not inside the networks allowed for this poller. Add the network first."
msgstr "Titik Akhir: nama diresolusi ke %s, yang tidak berada di dalam jaringan yang diizinkan untuk poller ini. Tambahkan jaringannya terlebih dahulu."


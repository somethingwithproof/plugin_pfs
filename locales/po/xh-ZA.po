#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: isitshixo somamkeli wenowudi asikho kwifayile yabamamkeli abaziwayo, okanye sitshintshile. Khangela isitshixo phambi kokusongeza."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: isiphelo sisonjululwa ngaphandle kothungelwano oluvunyelweyo lwephola %d, ngoko asifundwa."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: isikripthi sokufunda sibonise iiparamitha ezi-%d ezingafundwayo yiplagini, ngoko ayisiyiyo i-pfs-read.sh ethunyelweyo. Inowudi isenokuba iveza okungaphezulu kunoko kufunwa yiplagini."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: amagama eethagethi ezi-%d kwisiphumo senowudi awahambelananga nepatheni elindelweyo okanye inkqubo yeefayile kwaye akahoywanga."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Isifundi kwiphola %d asigqibanga ukusebenza kwimizuzwana engama-%d edlulileyo. Amaxabiso avela kwiinowudi zaso aya eguga."


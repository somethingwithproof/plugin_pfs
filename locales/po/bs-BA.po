#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: čvor je odgovorio bez fiksnog okvira skripte za čitanje. Moguće je da njegov ključ nije ograničen na prisilnu komandu koja pokreće pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: ključ računara za čvor ne nalazi se u datoteci poznatih računara ili se promijenio. Provjerite ključ prije nego što ga dodate."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: krajnja tačka se razrješava izvan mreža dozvoljenih za poller %d, pa se ne čita."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: skripta za čitanje je ispisala %d parametara koje dodatak ne čita, pa to nije isporučena skripta pfs-read.sh. Čvor možda izlaže više podataka nego što je dodatku potrebno."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d naziva ciljeva u izlazu čvora nije odgovaralo očekivanom obrascu ili datotečnom sistemu i zanemareno je."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Čitač na polleru %d nije dovršio nijedno pokretanje u posljednjih %d sekundi. Vrijednosti s njegovih čvorova zastarijevaju."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Instalacija šablona Parallel Filesystem nije uspjela: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Šabloni Parallel Filesystem nisu instalirani, pa nijedan uređaj ne može biti dodat."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Datoteka upita podataka resource/script_server/%s nedostaje u sistemu Cacti ili se razlikuje od one koju ovaj dodatak isporučuje, pa upiti podataka ne mogu prikazati spisak ciljeva."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Datotečni sistem %s mapiran je na uređaj %d koji više ne postoji."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Uređaj datotečnog sistema %s ispituje poller %d, ali njegove čvorove čita poller %d, čiji je keš potreban izvorima podataka tog uređaja."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Datoteka SSH ključa %s ne postoji na ovom serveru."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Datoteku SSH ključa %s mogu čitati ili mijenjati i drugi korisnici osim vlasnika (dozvole %s). Ograničite pristup samo na korisnika pollera."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Datoteka poznatih računara %s ne postoji na ovom serveru, pa nijedan čvor ne može biti pročitan."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "SSH klijent %s ne postoji na ovom serveru."

#: lib/NodeInput.php
msgid "Filesystem: choose one of the registered filesystems."
msgstr "Datotečni sistem: odaberite jedan od registrovanih datotečnih sistema."

#: lib/NodeInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Naziv: koristite od 1 do 64 slova, cifara, tačaka, crtica ili donjih crta, počevši slovom ili cifrom."

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "Uloga: odaberite jednu od navedenih uloga."

#: lib/NodeInput.php
msgid "Port: enter a port from 1 to 65535."
msgstr "Port: unesite port od 1 do 65535."

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "Ime za prijavu: koristite naziv naloga malim slovima od najviše 32 znaka, koji počinje slovom ili donjom crtom."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "Krajnja tačka: unesite samo naziv računara ili IP adresu, bez korisnika, porta ili putanje."

#: lib/NodeInput.php
msgid "Endpoint: the name does not resolve on this server."
msgstr "Krajnja tačka: naziv se ne razrješava na ovom serveru."

#: lib/NodeInput.php
#, php-format
msgid "Endpoint: it resolves to %s, which is not inside the networks allowed for this poller. Add the network first."
msgstr "Krajnja tačka: razrješava se na %s, što nije unutar mreža dozvoljenih za ovaj poller. Prvo dodajte mrežu."


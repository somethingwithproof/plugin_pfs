msgid "Filesystem: choose one of the registered filesystems."
msgstr "Système de fichiers : choisissez l'un des systèmes de fichiers enregistrés."

#: lib/NodeInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Nom : utilisez de 1 à 64 lettres, chiffres, points, tirets ou tirets bas, en commençant par une lettre ou un chiffre."

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "Rôle : choisissez l'un des rôles répertoriés."

#: lib/NodeInput.php

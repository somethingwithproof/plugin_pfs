#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: čvor je odgovorio bez fiksnog okvira skripte za čitanje. Moguće je da njegov ključ nije ograničen na nametnutu naredbu za pokretanje pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: ključ računala čvora nije u datoteci poznatih računala ili se promijenio. Provjerite ključ prije dodavanja."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: krajnja točka razrješava se izvan mreža dopuštenih za prikupljač %d pa se ne čita."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: skripta za čitanje ispisala je %d parametara koje dodatak ne čita, stoga to nije isporučena skripta pfs-read.sh. Čvor možda izlaže više podataka nego što je dodatku potrebno."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d naziva odredišta u izlazu čvora nije odgovaralo očekivanom uzorku ili datotečnom sustavu te je zanemareno."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Čitač na prikupljaču %d nije dovršio izvođenje u zadnjih %d sekundi. Vrijednosti s njegovih čvorova zastarijevaju."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Instalacija predložaka Parallel Filesystem nije uspjela: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Predlošci Parallel Filesystem nisu instalirani pa nije moguće dodati uređaj."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Datoteka upita podataka resource/script_server/%s nedostaje u sustavu Cacti ili se razlikuje od one koju ovaj dodatak isporučuje pa upiti podataka ne mogu ispisati popis odredišta."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Datotečni sustav %s pridružen je uređaju %d koji više ne postoji."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Uređaj datotečnog sustava %s obrađuje prikupljač %d, dok njegove čvorove čita prikupljač %d, čija je predmemorija potrebna izvorima podataka tog uređaja."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Datoteka SSH ključa %s ne postoji na ovom poslužitelju."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Datoteku SSH ključa %s mogu čitati ili u nju pisati i drugi korisnici osim vlasnika (dozvole %s). Ograničite pristup samo na korisnika prikupljača."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Datoteka poznatih računala %s ne postoji na ovom poslužitelju pa se nijedan čvor ne može pročitati."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "SSH klijent %s ne postoji na ovom poslužitelju."

#: lib/NodeInput.php
msgid "Filesystem: choose one of the registered filesystems."
msgstr "Datotečni sustav: odaberite jedan od registriranih datotečnih sustava."

#: lib/NodeInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Ime: upotrijebite 1 do 64 slova, znamenki, točaka, crtica ili podvlaka, počevši slovom ili znamenkom."

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "Uloga: odaberite jednu s popisa uloga."

#: lib/NodeInput.php
msgid "Port: enter a port from 1 to 65535."
msgstr "Priključak: unesite broj priključka od 1 do 65535."

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "Korisničko ime: upotrijebite naziv računa malim slovima od najviše 32 znaka, koji počinje slovom ili podvlakom."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "Krajnja točka: unesite samo ime računala ili IP adresu, bez korisnika, priključka ili putanje."

#: lib/NodeInput.php
msgid "Endpoint: the name does not resolve on this server."
msgstr "Krajnja točka: ime se ne razrješava na ovom poslužitelju."

#: lib/NodeInput.php
#, php-format
msgid "Endpoint: it resolves to %s, which is not inside the networks allowed for this poller. Add the network first."
msgstr "Krajnja točka: razrješava se u %s, što nije unutar mreža dopuštenih za ovaj prikupljač. Najprije dodajte mrežu."


#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s : le nœud a répondu sans l'encadrement fixe du script de lecture. Sa clé n'est peut-être pas limitée à une commande forcée exécutant pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s : la clé d'hôte du nœud ne figure pas dans le fichier known hosts, ou elle a changé. Vérifiez la clé avant de l'ajouter."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s : le point de terminaison se résout en dehors des réseaux autorisés pour le collecteur %d ; il n'est donc pas lu."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s : le script de lecture a affiché %d paramètres que l'extension ne lit pas ; il ne s'agit donc pas du script pfs-read.sh fourni. Le nœud expose peut-être plus d'informations que nécessaire pour l'extension."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s : %d noms de cibles dans la sortie du nœud ne correspondaient pas au motif ou au système de fichiers attendu et ont été ignorés."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Le lecteur sur le collecteur %d n'a terminé aucune exécution au cours des %d dernières secondes. Les valeurs de ses nœuds deviennent obsolètes."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "L'installation des modèles Parallel Filesystem a échoué : %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Les modèles Parallel Filesystem ne sont pas installés ; aucun appareil ne peut donc être ajouté."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Le fichier de requête de données resource/script_server/%s est absent de Cacti ou diffère de celui fourni par cette extension ; les requêtes de données ne peuvent donc pas lister les cibles."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Le système de fichiers %s est associé à l'appareil %d, qui n'existe plus."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "L'appareil du système de fichiers %s est interrogé par le collecteur %d, mais ses nœuds sont lus par le collecteur %d, dont les sources de données de l'appareil ont besoin du cache."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Le fichier de clé SSH %s n'existe pas sur ce serveur."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Le fichier de clé SSH %s peut être lu ou modifié par d'autres utilisateurs que son propriétaire (mode %s). Limitez son accès à l'utilisateur du collecteur."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Le fichier known hosts %s n'existe pas sur ce serveur ; aucun nœud ne peut donc être lu à partir de celui-ci."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "Le client SSH %s n'existe pas sur ce serveur."

#: lib/NodeInput.php
msgid "Filesystem: choose one of the registered filesystems."
msgstr "Système de fichiers : choisissez l'un des systèmes de fichiers enregistrés."

#: lib/NodeInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Nom : utilisez de 1 à 64 lettres, chiffres, points, tirets ou tirets bas, en commençant par une lettre ou un chiffre."

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "Rôle : choisissez l'un des rôles listés."

#: lib/NodeInput.php
msgid "Port: enter a port from 1 to 65535."
msgstr "Port : saisissez un port de 1 à 65535."

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "Nom de connexion : utilisez un nom de compte en minuscules d'au plus 32 caractères, commençant par une lettre ou un tiret bas."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "Point de terminaison : saisissez uniquement un nom d'hôte ou une adresse IP, sans utilisateur, port ni chemin."

#: lib/NodeInput.php
msgid "Endpoint: the name does not resolve on this server."
msgstr "Point de terminaison : le nom ne se résout pas sur ce serveur."

#: lib/NodeInput.php
#, php-format
msgid "Endpoint: it resolves to %s, which is not inside the networks allowed for this poller. Add the network first."
msgstr "Point de terminaison : il se résout vers %s, qui ne fait pas partie des réseaux autorisés pour ce collecteur. Ajoutez d'abord le réseau."


msgstr "Insticksprogrammet Parallel Filesystem kräver PHP %s eller senare. Denna server kör PHP %s, så insticksprogrammet installerades eller aktiverades inte."

#: setup.php
msgid "The Parallel Filesystem plugin is not enabled."
msgstr "Insticksprogrammet Parallel Filesystem är inte aktiverat."


#: lib/NodeInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "نام: کسی حرف یا ہندسے سے شروع کرتے ہوئے 1 سے 64 حروف، ہندسے، نقطے، ڈیش، یا انڈراسکور استعمال کریں۔"

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "کردار: درج کردہ کرداروں میں سے ایک کا انتخاب کریں۔"

#: lib/NodeInput.php
msgid "Port: enter a port from 1 to 65535."
msgstr "پورٹ: 1 سے 65535 تک ایک پورٹ درج کریں۔"

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "لاگ ان نام: زیادہ سے زیادہ 32 حروف کا چھوٹے حروف (lower-case) والا اکاؤنٹ نام استعمال کریں، جو کسی حرف یا انڈراسکور سے شروع ہو۔"

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."

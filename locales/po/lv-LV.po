#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: mezgls atbildēja bez fiksētā lasīšanas skripta ietvara. Tā atslēga, iespējams, nav ierobežota ar piespiedu komandu, kas palaiž pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: mezgla resursdatora atslēga nav zināmo resursdatoru failā vai ir mainījusies. Pirms pievienošanas pārbaudiet atslēgu."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: galapunkts tiek atrisināts ārpus aptaujātājam %d atļautajiem tīkliem, tāpēc tas netiek lasīts."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: lasīšanas skripts izvadīja %d parametrus, kurus spraudnis nelasa, tāpēc tas nav piegādātais pfs-read.sh. Mezgls, iespējams, atklāj vairāk datu, nekā spraudnim nepieciešams."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d mērķu nosaukumi mezgla izvadē neatbilda paredzamajam šablonam vai failu sistēmai un tika ignorēti."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Lasītājs uz aptaujātāja %d pēdējo %d sekunžu laikā nav pabeidzis izpildi. Vērtības no tā mezgliem kļūst novecojušas."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Paralēlās failu sistēmas veidņu instalēšana neizdevās: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Paralēlās failu sistēmas veidnes nav instalētas, tāpēc nevar pievienot nevienu ierīci."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Datu vaicājuma fails resource/script_server/%s trūkst Cacti instalācijā vai atšķiras no šī spraudņa piegādātā faila, tāpēc datu vaicājumi nevar uzskaitīt mērķus."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Failu sistēma %s ir piesaistīta ierīcei %d, kura vairs neeksistē."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Failu sistēmas %s ierīci aptaujā aptaujātājs %d, bet tās mezglus lasa aptaujātājs %d, kura kešatmiņa ir nepieciešama ierīces datu avotiem."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "SSH atslēgas fails %s šajā serverī neeksistē."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "SSH atslēgas failu %s var lasīt vai rakstīt citi lietotāji, ne tikai tā īpašnieks (tiesības %s). Ierobežojiet piekļuvi tikai aptaujātāja lietotājam."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Zināmo resursdatoru fails %s šajā serverī neeksistē, tāpēc no tā nevar nolasīt nevienu mezglu."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "SSH klients %s šajā serverī neeksistē."


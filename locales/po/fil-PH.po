#: pfs_admin.php
msgid "That record belongs to a Cacti device you do not have permission for. Nothing was changed."
msgstr "Ang talaang iyon ay kabilang sa isang device ng Cacti na wala kang pahintulot. Walang binago."

#: pfs_admin.php
msgid "Name: another filesystem of this backend already uses this name."
msgstr "Pangalan: ginagamit na ng isa pang filesystem ng backend na ito ang pangalang ito."

#: pfs_admin.php
msgid "The filesystem could not be saved."
msgstr "Hindi mai-save ang filesystem."

#: pfs_admin.php
msgid "The filesystem was saved."
msgstr "Na-save ang filesystem."

#: pfs_admin.php
msgid "The filesystem, its nodes, and its inventory were deleted. Its Cacti device, data sources, and graphs were kept. No node was contacted."
msgstr "Tinanggal ang filesystem, mga node nito, at imbentaryo nito. Pinanatili ang device ng Cacti, mga data source, at mga graph nito. Walang node na kinontak."

#: pfs_admin.php
msgid "Name: another node already uses this name."

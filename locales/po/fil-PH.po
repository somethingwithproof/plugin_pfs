#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: sumagot ang node nang walang nakatakdang framing ng read script. Maaaring hindi limitado ang key nito sa isang sapilitang command na nagpapatakbo ng pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: wala ang host key ng node sa file ng mga known host, o nagbago ito. Suriin ang key bago ito idagdag."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: nagre-resolve ang endpoint sa labas ng mga network na pinapayagan para sa poller %d, kaya hindi ito binabasa."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: nag-print ang read script ng %d parameter na hindi binabasa ng plugin, kaya hindi ito ang kasamang pfs-read.sh. Maaaring naglalantad ang node ng higit pa sa kailangan ng plugin."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d pangalan ng target sa output ng node ang hindi tumugma sa inaasahang pattern o filesystem at binalewala ang mga ito."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Hindi nakatapos ng pagtakbo ang reader sa poller %d sa nakalipas na %d segundo. Nagiging luma na ang mga halaga mula sa mga node nito."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Nabigo ang pag-install ng mga template ng Parallel Filesystem: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Hindi naka-install ang mga template ng Parallel Filesystem, kaya walang device na maidaragdag."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Nawawala sa Cacti ang data query file na resource/script_server/%s o naiiba ito sa kasamang file ng plugin na ito, kaya hindi mailista ng mga data query ang mga target."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Naka-map ang filesystem na %s sa device %d, na hindi na umiiral."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Ang device ng filesystem na %s ay pinopoll ng poller %d, ngunit ang mga node nito ay binabasa ng poller %d, na ang cache nito ay kailangan ng mga data source ng device."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Hindi umiiral sa server na ito ang SSH key file na %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Ang SSH key file na %s ay maaaring basahin o sulatan ng mga user bukod sa may-ari nito (mode %s). Limitahan ito sa user ng poller."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Hindi umiiral sa server na ito ang known hosts file na %s, kaya walang node na mababasa mula rito."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "Hindi umiiral sa server na ito ang SSH client na %s."


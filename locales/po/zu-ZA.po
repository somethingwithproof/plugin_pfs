#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: inodi liphendule ngaphandle kohlaka olungaguquki lweskripthi sokufunda. Ukhiye walo kungenzeka awukhawulelwe kumyalo ophoqelelwe osebenzisa i-pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: ukhiye wehosti yenodi awukho kufayela lamahosti aziwayo, noma ushintshile. Hlola ukhiye ngaphambi kokuwengeza."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: i-endpoint ixazulula ngaphandle kwamanethiwekhi avunyelwe i-poller %d, ngakho ayifundwa."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: iskripthi sokufunda siphrinte amapharamitha angu-%d i-plugin engawafundi, ngakho akuyona i-pfs-read.sh ethunyelwe. Inodi kungenzeka lidalula okuningi kunokudingwa yi-plugin."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: amagama amathagethi angu-%d kumphumela wenodi awafananga nephethini elindelwe noma uhlelo lwamafayela futhi azitshiwe."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Isifundi ku-poller %d asikaqedi ukusebenza emizuzwaneni engu-%d edlule. Amanani avela kumanodi aso aseba madala."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Ukufaka amathempulethi e-Parallel Filesystem kwehlulekile: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Amathempulethi e-Parallel Filesystem awafakiwe, ngakho ayikho idivayisi engengezwa."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Ifayela lombuzo wedatha resource/script_server/%s alikho ku-Cacti noma lihlukile kulelo elithunyelwa yile plugin, ngakho imibuzo yedatha ayikwazi ukufaka ohlwini amathagethi."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Uhlelo lwamafayela %s luhlotshaniswe nedivayisi %d, engasekho."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Idivayisi yohlelo lwamafayela %s ihlolwa yi-poller %d, kodwa amanodi ayo afundwa yi-poller %d, inqolobane yayo edingwa yimithombo yedatha yedivayisi."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Ifayela lokhiye we-SSH %s alikho kule seva."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Ifayela lokhiye we-SSH %s lingafundwa noma libhalwe ngabasebenzisi ngaphandle komnikazi walo (imodi %s). Likhawulele kumsebenzisi we-poller."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Ifayela lamahosti aziwayo %s alikho kule seva, ngakho alikho inodi elingafundwa kulo."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "Iklayenti ye-SSH %s ayikho kule seva."


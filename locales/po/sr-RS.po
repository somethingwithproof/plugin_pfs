#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Уређај \"%s\" из шаблона уређаја %s, који испитује полер %d, са искљученим проверама доступности."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", listing %d targets known now. It creates no graph by itself."
msgstr "Упит података \"%s\", који даје списак од %d тренутно познатих циљева. Сам по себи не прави ниједан графикон."


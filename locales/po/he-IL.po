msgstr "ערכים ידועים"

#: lib/TargetsPage.php
msgid "Last Seen"
msgstr "נראה לאחרונה"

#: lib/TargetsPage.php
msgid "Recovery"
msgstr "התאוששות"

#: lib/TargetsPage.php

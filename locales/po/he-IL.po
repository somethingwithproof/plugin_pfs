#: lib/Pages.php
msgid "Parallel Filesystem Health"
msgstr "תקינות מערכות קבצים מקביליות"

#: lib/ReadError.php
msgid "The plugin settings for node access are incomplete or unusable"
msgstr "הגדרות התוסף לגישה לצמתים אינן שלמות או שאינן שמישות"

#: lib/ReadError.php
msgid "The endpoint resolves outside the networks allowed for its poller"
msgstr "נקודת הקצה מתורגמת לכתובת מחוץ לרשתות המורשות עבור הדוגם שלה"

#: lib/ReadError.php
msgid "The endpoint name does not resolve"
msgstr "שם נקודת הקצה אינו מתורגם לכתובת"

#: lib/ReadError.php
msgid "The node could not be reached"
msgstr "לא ניתן היה להגיע לצומת"

#: lib/ReadError.php
msgid "The node host key is unknown or changed"
msgstr "מפתח המארח של הצומת אינו מוכר או שהשתנה"

#: lib/ReadError.php
msgid "The node refused the key"
msgstr "הצומת דחה את המפתח"

#: lib/ReadError.php
msgid "The read exceeded its time limit"
msgstr "הקריאה חרגה ממגבלת הזמן שלה"

#: lib/ReadError.php
msgid "The response exceeded the size limit"
msgstr "התגובה חרגה ממגבלת הגודל"

#: lib/ReadError.php
msgid "The read command failed"
msgstr "פקודת הקריאה נכשלה"

#: lib/ReadError.php
msgid "The node did not answer with the fixed read script"
msgstr "הצומת לא השיב באמצעות סקריפט הקריאה הקבוע"

#: lib/ReadError.php
msgid "The response ended before the read script finished"
msgstr "התגובה הסתיימה לפני שסקריפט הקריאה סיים"

#: lib/Settings.php
msgid "Node Access"
msgstr "גישה לצמתים"

#: lib/Settings.php
msgid "Absolute path to the ssh client on each poller that reads nodes."
msgstr "נתיב מוחלט אל לקוח ה-ssh בכל דוגם שקורא צמתים."

#: lib/Settings.php
msgid "SSH Client"
msgstr "לקוח SSH"

#: lib/Settings.php
msgid "Absolute path, on each poller that reads nodes, to the private key whose public half each node lists in authorized_keys with a forced command running pfs-read.sh. Readable only by the poller user. The plugin never creates, copies, or prints it."
msgstr "נתיב מוחלט, בכל דוגם שקורא צמתים, אל המפתח הפרטי שחציו הציבורי רשום בכל צומת ב-authorized_keys עם פקודה מאולצת המריצה את pfs-read.sh. קריא רק על ידי משתמש הדוגם. התוסף לעולם אינו יוצר, מעתיק או מדפיס אותו."

#: lib/Settings.php
msgid "SSH Key File"
msgstr "קובץ מפתח SSH"

#: lib/Settings.php
msgid "Absolute path to the known_hosts file holding each node host key under the node endpoint name. A node whose key is missing or changed is not read."
msgstr "נתיב מוחלט אל קובץ known_hosts המחזיק את מפתח המארח של כל צומת תחת שם נקודת הקצה של הצומת. צומת שהמפתח שלו חסר או השתנה אינו נקרא."

#: lib/Settings.php
msgid "Known Hosts File"
msgstr "קובץ מארחים מוכרים"

#: lib/Settings.php
msgid "Connect Timeout"
msgstr "זמן קצוב לחיבור"

#: lib/Settings.php
msgid "Seconds to wait for a node to accept the connection."
msgstr "שניות להמתנה עד שצומת יקבל את החיבור."

#: lib/Settings.php
msgid "Read Timeout"
msgstr "זמן קצוב לקריאה"

#: lib/Settings.php
msgid "Seconds one node read may take in total before it is stopped and recorded as failed."
msgstr "מספר השניות הכולל שקריאת צומת אחת עשויה להימשך לפני שתיעצר ותירשם כנכשלת."

#: lib/Settings.php
msgid "KiB one node may return. A larger answer is discarded and recorded as failed."
msgstr "מספר ה-KiB שצומת אחד רשאי להחזיר. תשובה גדולה יותר נזרקת ונרשמת כנכשלת."

#: lib/Settings.php
msgid "Maximum Response"
msgstr "תגובה מרבית"

#: lib/Settings.php
msgid "Reader"
msgstr "קורא"

#: lib/Settings.php
msgid "Reader Time Budget"
msgstr "תקציב זמן לקורא"

#: lib/Settings.php
msgid "Seconds one reader run may spend before it stops starting node reads. Keep it below the poller interval; unread nodes are read on the next run."
msgstr "מספר השניות שריצת קורא אחת עשויה לצרוך לפני שתפסיק להתחיל קריאות צמתים. שמור על ערך נמוך ממרווח הדוגם; צמתים שלא נקראו ייקראו בריצה הבאה."

#: lib/Settings.php
msgid "Concurrent Reads"
msgstr "קריאות מקביליות"

#: lib/Settings.php
msgid "Node reads one reader runs at the same time."
msgstr "קריאות צמתים שקורא אחד מריץ בו-זמנית."

#: lib/Settings.php
msgid "Uninstall"
msgstr "הסרת התקנה"

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "שמור את טבלאות התוסף בעת הסרת ההתקנה"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin keeps its filesystems, nodes, inventory, and cache. Clear it to have the uninstall drop them; export the registry first from the Parallel Filesystem Admin page. Storage nodes are never contacted either way."
msgstr "כאשר מסומן, הסרת התקנת התוסף שומרת על מערכות הקבצים, הצמתים, המלאי והמטמון שלו. בטל את הסימון כדי שהסרת ההתקנה תמחק אותם; ייצא תחילה את הרישום מדף ניהול מערכת קבצים מקבילית. בכל מקרה לעולם אין נוצר קשר עם צמתי האחסון."

#: lib/Settings.php
msgid "Delete the Devices This Plugin Created on Uninstall"
msgstr "מחק את ההתקנים שתוסף זה יצר בעת הסרת ההתקנה"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin deletes the devices it created for filesystems, with their graphs and data sources, as deleting them in Cacti would. Existing devices that were mapped to a filesystem are never deleted. RRD files are removed only if Cacti's own RRD cleanup setting removes them. Cleared, the devices stay."
msgstr "כאשר מסומן, הסרת התקנת התוסף מוחקת את ההתקנים שיצר עבור מערכות קבצים, כולל הגרפים ומקורות הנתונים שלהם, כפי שמחיקתם ב-Cacti הייתה עושה. התקנים קיימים שמופו למערכת קבצים לעולם אינם נמחקים. קובצי RRD מוסרים רק אם הגדרת ניקוי ה-RRD של Cacti עצמה מסירה אותם. כאשר אינו מסומן, ההתקנים נשארים."

#: lib/TargetsPage.php

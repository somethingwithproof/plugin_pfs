#: pfs_admin.php
msgid "That record belongs to a Cacti device you do not have permission for. Nothing was changed."
msgstr "רשומה זו שייכת להתקן Cacti שאין לך הרשאה אליו. דבר לא שונה."

#: pfs_admin.php
msgid "Name: another filesystem of this backend already uses this name."
msgstr "שם: מערכת קבצים אחרת של מערכת עורפית זו כבר משתמשת בשם זה."

#: pfs_admin.php
msgid "The filesystem could not be saved."
msgstr "לא ניתן היה לשמור את מערכת הקבצים."

#: pfs_admin.php
msgid "The filesystem was saved."
msgstr "מערכת הקבצים נשמרה."

#: pfs_admin.php
msgid "The filesystem, its nodes, and its inventory were deleted. Its Cacti device, data sources, and graphs were kept. No node was contacted."
msgstr "מערכת הקבצים, הצמתים שלה והמלאי שלה נמחקו. התקן ה-Cacti, מקורות הנתונים והגרפים שלה נשמרו. לא נוצר קשר עם אף צומת."

#: pfs_admin.php
msgid "Name: another node already uses this name."
msgstr "שם: צומת אחר כבר משתמש בשם זה."

#: pfs_admin.php
msgid "The node could not be saved."
msgstr "לא ניתן היה לשמור את הצומת."

#: pfs_admin.php
msgid "The node was saved."
msgstr "הצומת נשמר."

#: pfs_admin.php
msgid "The node was deleted. Targets it reported keep their history."
msgstr "הצומת נמחק. היעדים שדיווח שומרים על ההיסטוריה שלהם."

#: pfs_admin.php
msgid "Enter a network as an address and prefix length, such as 10.20.0.0/16."
msgstr "הזן רשת ככתובת ואורך קידומת, כגון 10.20.0.0/16."

#: pfs_admin.php
msgid "No device was added: the filesystem already has one, or the templates are not installed."
msgstr "לא נוסף התקן: למערכת הקבצים כבר יש התקן, או שהתבניות אינן מותקנות."

#: pfs_admin.php
msgid "The device could not be mapped. It may be mapped to another filesystem."
msgstr "לא ניתן היה למפות את ההתקן. ייתכן שהוא ממופה למערכת קבצים אחרת."

#: pfs_admin.php
msgid "The device was mapped and the data queries and overview graphs were added."
msgstr "ההתקן מופה ושאילתות הנתונים וגרפי הסקירה נוספו."

#: pfs_admin.php
msgid "Cacti did not create the device. See the Cacti log."
msgstr "Cacti לא יצר את ההתקן. עיין ביומן של Cacti."

#: pfs_admin.php
msgid "The device, its data queries, and its overview graphs were created."
msgstr "ההתקן, שאילתות הנתונים שלו וגרפי הסקירה שלו נוצרו."

#: pfs_admin.php
msgid "The device is no longer mapped. It and its graphs were kept; its data queries list no targets until it is mapped again."
msgstr "ההתקן אינו ממופה עוד. ההתקן והגרפים שלו נשמרו; שאילתות הנתונים שלו לא יפרטו יעדים עד שימופה שוב."

#: pfs_health.php
msgid "The templates and data query files were installed."
msgstr "התבניות וקובצי שאילתות הנתונים הותקנו."

#: pfs_health.php
#, php-format
msgid "The templates could not be installed: %s"
msgstr "לא ניתן היה להתקין את התבניות: %s"

#: pfs_operator.php
msgid "Monitoring view"
msgstr "תצוגת ניטור"

#: pfs_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "לא ניתן היה לקרוא תצפיות. בקש ממנהל המערכת לבדוק את יומן התוסף."


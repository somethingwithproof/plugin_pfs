#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: чвор је одговорио без фиксног оквира скрипте за читање. Могуће је да његов кључ није ограничен на принудну команду која покреће pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: кључ рачунара чвора није у датотеци познатих рачунара или је промењен. Проверите кључ пре додавања."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: крајња тачка се разрешава изван мрежа дозвољених за полер %d, па се не чита."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: скрипта за читање је исписала %d параметара које додатак не чита, па то није испоручена скрипта pfs-read.sh. Чвор можда излаже више података него што је додатку потребно."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d назива циљева у излазу чвора није одговарало очекиваном обрасцу или систему датотека и занемарено је."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Читач на полеру %d није завршио покретање у последњих %d секунди. Вредности са његових чворова застаревају."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Инсталација шаблона Parallel Filesystem није успела: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Шаблони Parallel Filesystem нису инсталирани, па се ниједан уређај не може додати."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Датотека упита података resource/script_server/%s недостаје у систему Cacti или се разликује од оне коју овај додатак испоручује, па упити података не могу приказати списак циљева."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Систем датотека %s мапиран је на уређај %d који више не постоји."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Уређај система датотека %s испитује полер %d, али његове чворове чита полер %d, чији је кеш потребан изворима података тог уређаја."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Датотека SSH кључа %s не постоји на овом серверу."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Датотеку SSH кључа %s могу читати или мењати и други корисници осим власника (дозволе %s). Ограничите приступ само на корисника полера."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Датотека познатих рачунара %s не постоји на овом серверу, па ниједан чвор не може бити прочитан."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "SSH клијент %s не постоји на овом серверу."

#: lib/NodeInput.php
msgid "Filesystem: choose one of the registered filesystems."
msgstr "Систем датотека: изаберите један од регистрованих система датотека."

#: lib/NodeInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Назив: користите од 1 до 64 слова, цифара, тачака, цртица или доњих црта, почевши словом или цифром."

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "Улога: изаберите једну од наведених улога."

#: lib/NodeInput.php
msgid "Port: enter a port from 1 to 65535."
msgstr "Порт: унесите порт од 1 до 65535."

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "Име за пријаву: користите назив налога малим словима од највише 32 знака, који почиње словом или доњом цртом."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "Крајња тачка: унесите само име рачунара или IP адресу, без корисника, порта или путање."

#: lib/NodeInput.php
msgid "Endpoint: the name does not resolve on this server."
msgstr "Крајња тачка: име се не разрешава на овом серверу."

#: lib/NodeInput.php
#, php-format
msgid "Endpoint: it resolves to %s, which is not inside the networks allowed for this poller. Add the network first."
msgstr "Крајња тачка: разрешава се на %s, што није унутар мрежа дозвољених за овај полер. Прво додајте мрежу."


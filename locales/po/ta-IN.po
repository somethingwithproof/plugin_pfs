msgstr "%s: போலர் %d க்கு அனுமதிக்கப்பட்ட பிணையங்களுக்கு வெளியே முனையம் தீர்க்கப்படுகிறது, எனவே அது வாசிக்கப்படவில்லை."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: செருகுநிரல் வாசிக்காத %d அளவுருக்களை வாசிப்பு ஸ்கிரிப்ட் அச்சிட்டது, எனவே இது வழங்கப்பட்ட pfs-read.sh அல்ல. செருகுநிரலுக்குத் தேவையானதை விட அதிகமாக முனை வெளிப்படுத்தக்கூடும்."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: முனை வெளியீட்டில் உள்ள %d இலக்குப் பெயர்கள் எதிர்பார்க்கப்படும் வடிவத்துடன் அல்லது கோப்பு முறைமையுடன் பொருந்தவில்லை, எனவே அவை புறக்கணிக்கப்பட்டன."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "போலர் %d இல் உள்ள வாசிப்பான் கடந்த %d விநாடிகளில் ஒரு இயக்கத்தை முடிக்கவில்லை. அதன் முனைகளிலிருந்து வரும் மதிப்புகள் பழையதாகின்றன."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "இணை கோப்பு முறைமை வார்ப்புருக்களை நிறுவுவது தோல்வியடைந்தது: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "இணை கோப்பு முறைமை வார்ப்புருக்கள் நிறுவப்படவில்லை, எனவே எந்தச் சாதனத்தையும் சேர்க்க முடியாது."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "தரவு வினவல் கோப்பு resource/script_server/%s Cacti இல் காணவில்லை அல்லது இந்தச் செருகுநிரல் வழங்கும் கோப்பிலிருந்து வேறுபடுகிறது, எனவே தரவு வினவல்களால் இலக்குகளைப் பட்டியலிட முடியாது."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "கோப்பு முறைமை %s சாதனம் %d உடன் இணைக்கப்பட்டுள்ளது, ஆனால் அது இப்போது இல்லை."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "கோப்பு முறைமை %s இன் சாதனம் போலர் %d ஆல் வாக்கெடுக்கப்படுகிறது, ஆனால் அதன் முனைகள் போலர் %d ஆல் வாசிக்கப்படுகின்றன, அதன் இடைமாற்றகம் சாதனத்தின் தரவு மூலங்களுக்குத் தேவைப்படுகிறது."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "SSH விசைக் கோப்பு %s இந்தச் சேவையகத்தில் இல்லை."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "SSH விசைக் கோப்பு %s அதன் உரிமையாளரைத் தவிர மற்ற பயனர்களால் வாசிக்கப்படலாம் அல்லது எழுதப்படலாம் (பயன்முறை %s). அதைப் போலர் பயனருக்கு மட்டும் வரம்பிடவும்."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "known hosts கோப்பு %s இந்தச் சேவையகத்தில் இல்லை, எனவே அதிலிருந்து எந்த முனையையும் வாசிக்க முடியாது."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "SSH கிளையன்ட் %s இந்தச் சேவையகத்தில் இல்லை."

#: lib/NodeInput.php
msgid "Filesystem: choose one of the registered filesystems."
msgstr "கோப்பு முறைமை: பதிவுசெய்யப்பட்ட கோப்பு முறைமைகளில் ஒன்றைத் தேர்ந்தெடுக்கவும்."

#: lib/NodeInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "பெயர்: ஓர் எழுத்து அல்லது இலக்கத்துடன் தொடங்கி, 1 முதல் 64 எழுத்துகள், இலக்கங்கள், புள்ளிகள், இடைக்கோடுகள் அல்லது அடிக்கோடுகளைப் பயன்படுத்தவும்."

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "பங்கு: பட்டியலிடப்பட்ட பங்குகளில் ஒன்றைத் தேர்ந்தெடுக்கவும்."

#: lib/NodeInput.php
msgid "Port: enter a port from 1 to 65535."
msgstr "துறை: 1 முதல் 65535 வரையிலான ஒரு துறையை உள்ளிடவும்."

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "உள்நுழைவுப் பெயர்: எழுத்து அல்லது அடிக்கோட்டில் தொடங்கும், அதிகபட்சம் 32 எழுத்துகள் கொண்ட சிற்றெழுத்துக் கணக்குப் பெயரைப் பயன்படுத்தவும்."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "முனையம்: பயனர், துறை அல்லது பாதை இல்லாமல் புரவலன் பெயர் அல்லது IP முகவரியை மட்டும் உள்ளிடவும்."

#: lib/NodeInput.php
msgid "Endpoint: the name does not resolve on this server."
msgstr "முனையம்: இந்தச் சேவையகத்தில் பெயர் தீர்க்கப்படவில்லை."

#: lib/NodeInput.php
#, php-format
msgid "Endpoint: it resolves to %s, which is not inside the networks allowed for this poller. Add the network first."
msgstr "முனையம்: இது %s ஆகத் தீர்க்கப்படுகிறது, இது இந்தப் போலருக்கு அனுமதிக்கப்பட்ட பிணையங்களுக்குள் இல்லை. முதலில் பிணையத்தைச் சேர்க்கவும்."


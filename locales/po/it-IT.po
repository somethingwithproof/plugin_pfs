msgstr "Nome: utilizzare da 1 a 64 caratteri tra lettere, cifre, punti, trattini o trattini bassi, iniziando con una lettera o una cifra."

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "Ruolo: scegliere uno dei ruoli elencati."

#: lib/NodeInput.php
msgid "Port: enter a port from 1 to 65535."
msgstr "Porta: inserire una porta da 1 a 65535."

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "Nome di accesso: utilizzare un nome account in minuscolo di al massimo 32 caratteri, che inizi con una lettera o un trattino basso."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "Endpoint: inserire solo un nome host o un indirizzo IP, senza utente, porta o percorso."

#: lib/NodeInput.php
msgid "Endpoint: the name does not resolve on this server."
msgstr "Endpoint: il nome non si risolve su questo server."


msgstr "Lelo rekhodi lingeledivayisi ye-Cacti ongenamvume yayo. Akukho lutho olushintshiwe."

#: pfs_admin.php
msgid "Name: another filesystem of this backend already uses this name."
msgstr "Igama: olunye uhlelo lwamafayela lwale backend selivele lusebenzisa leli gama."


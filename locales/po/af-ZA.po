msgstr "Lêerstelsel: kies een van die geregistreerde lêerstelsels."

#: lib/NodeInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Naam: gebruik 1 tot 64 letters, syfers, punte, koppeltekens of onderstrepe, beginnende met 'n letter of syfer."

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "Rol: kies een van die gelyste rolle."

#: lib/NodeInput.php
msgid "Port: enter a port from 1 to 65535."
msgstr "Poort: voer 'n poort van 1 tot 65535 in."

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "Aanmeldnaam: gebruik 'n kleinletter-rekeningnaam van hoogstens 32 karakters, wat met 'n letter of onderstreep begin."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "Eindpunt: voer slegs 'n gasheernaam of 'n IP-adres in, sonder 'n gebruiker, poort of pad."

#: lib/NodeInput.php
msgid "Endpoint: the name does not resolve on this server."
msgstr "Eindpunt: die naam los nie op hierdie bediener op nie."

#: lib/NodeInput.php

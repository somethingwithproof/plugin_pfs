#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: ihuriro ryashubije nta miterere yagenwe ya script yo gusoma. Urufunguzo rwaryo rushobora kuba rutabujijwe gukora gusa itegeko ryahatirijwe ritangiza pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: urufunguzo rwa host rw'ihuriro ntiruri muri dosiye ya known_hosts, cyangwa rwahindutse. Suzuma urufunguzo mbere yo kurwongeramo."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: aderesi y'ihuriro ihindukira hanze y'imiyoboro yemewe kuri poller %d, bityo ntirisomwa."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: script yo gusoma yatanze ibipimo %d umugereka udasoma, bityo si pfs-read.sh yatanzwe. Ihuriro rishobora kuba rishyira ahagaragara ibirenze ibyo umugereka ukeneye."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: amazina y'intego %d mu bisubizo by'ihuriro ntiyahuye n'imiterere iteganyijwe cyangwa sisitemu y'amadosiye maze ararengagizwa."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Umusomyi uri kuri poller %d ntarangije igikorwa mu masegonda %d ashize. Indangagaciro ziva ku mahuriro ye ziri gushira igihe."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Gushyiramo inyandikorugero za Parallel Filesystem byanze: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Inyandikorugero za Parallel Filesystem ntizashyizwemo, bityo nta gikoresho gishobora kongerwamo."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Dosiye y'ishakisha ry'amakuru resource/script_server/%s ibuze muri Cacti cyangwa itandukanye n'iyo uyu mugereka utanga, bityo ishakisha ry'amakuru ntirishobora gutondekanya intego."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Sisitemu y'amadosiye %s ihujwe n'igikoresho %d, kitakibaho."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Igikoresho cya sisitemu y'amadosiye %s gisomwa na poller %d, ariko amahuriro yacyo asomwa na poller %d, ufite ububiko bw'agateganyo inkomoko z'amakuru z'igikoresho zikeneye."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Dosiye y'urufunguzo rwa SSH %s ntibaho kuri iyi seriveri."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Dosiye y'urufunguzo rwa SSH %s ishobora gusomwa cyangwa kwandikwaho n'abandi bakoresha batari nyirayo (mode %s). Yigabanyirize umukoresha wa poller gusa."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Dosiye ya known_hosts %s ntibaho kuri iyi seriveri, bityo nta huriro rishobora gusomwa riyiturukamo."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "Porogaramu ikoresha SSH %s ntibaho kuri iyi seriveri."


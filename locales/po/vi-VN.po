msgstr "Điểm cuối phân giải ra ngoài các mạng được phép cho poller của nó"

#: lib/ReadError.php
msgid "The endpoint name does not resolve"
msgstr "Tên điểm cuối không phân giải được"

#: lib/ReadError.php
msgid "The node could not be reached"
msgstr "Không thể kết nối tới nút"

#: lib/ReadError.php
msgid "The node host key is unknown or changed"
msgstr "Khóa máy chủ của nút không xác định hoặc đã thay đổi"

#: lib/ReadError.php
msgid "The node refused the key"
msgstr "Nút đã từ chối khóa"

#: lib/ReadError.php
msgid "The read exceeded its time limit"
msgstr "Lần đọc đã vượt quá giới hạn thời gian"

#: lib/ReadError.php
msgid "The response exceeded the size limit"
msgstr "Phản hồi đã vượt quá giới hạn kích thước"

#: lib/ReadError.php
msgid "The read command failed"
msgstr "Lệnh đọc thất bại"

#: lib/ReadError.php
msgid "The node did not answer with the fixed read script"
msgstr "Nút không trả lời bằng tập lệnh đọc cố định"

#: lib/ReadError.php
msgid "The response ended before the read script finished"
msgstr "Phản hồi kết thúc trước khi tập lệnh đọc hoàn tất"

#: lib/Settings.php
msgid "Node Access"
msgstr "Truy cập nút"

#: lib/Settings.php
msgid "Absolute path to the ssh client on each poller that reads nodes."
msgstr "Đường dẫn tuyệt đối đến ứng dụng khách ssh trên mỗi poller thực hiện đọc nút."

#: lib/Settings.php
msgid "SSH Client"
msgstr "Ứng dụng khách SSH"

#: lib/Settings.php
msgid "Absolute path, on each poller that reads nodes, to the private key whose public half each node lists in authorized_keys with a forced command running pfs-read.sh. Readable only by the poller user. The plugin never creates, copies, or prints it."
msgstr "Đường dẫn tuyệt đối, trên mỗi poller đọc nút, đến khóa riêng tư mà phần khóa công khai của nó được mỗi nút liệt kê trong authorized_keys với lệnh bắt buộc chạy pfs-read.sh. Chỉ người dùng poller mới có quyền đọc. Plugin không bao giờ tạo, sao chép hoặc in khóa này."

#: lib/Settings.php
msgid "SSH Key File"
msgstr "Tệp khóa SSH"

#: lib/Settings.php
msgid "Absolute path to the known_hosts file holding each node host key under the node endpoint name. A node whose key is missing or changed is not read."
msgstr "Đường dẫn tuyệt đối đến tệp known_hosts lưu khóa máy chủ của từng nút theo tên điểm cuối của nút. Nút có khóa bị thiếu hoặc đã thay đổi sẽ không được đọc."

#: lib/Settings.php
msgid "Known Hosts File"
msgstr "Tệp Known Hosts"

#: lib/Settings.php
msgid "Connect Timeout"
msgstr "Thời gian chờ kết nối"

#: lib/Settings.php
msgid "Seconds to wait for a node to accept the connection."
msgstr "Số giây chờ nút chấp nhận kết nối."

#: lib/Settings.php
msgid "Read Timeout"
msgstr "Thời gian chờ đọc"

#: lib/Settings.php
msgid "Seconds one node read may take in total before it is stopped and recorded as failed."
msgstr "Tổng số giây tối đa cho một lần đọc nút trước khi bị dừng và ghi nhận là thất bại."

#: lib/Settings.php
msgid "KiB one node may return. A larger answer is discarded and recorded as failed."
msgstr "Số KiB tối đa một nút có thể trả về. Phản hồi lớn hơn sẽ bị hủy bỏ và ghi nhận là thất bại."

#: lib/Settings.php
msgid "Maximum Response"
msgstr "Phản hồi tối đa"

#: lib/Settings.php
msgid "Reader"
msgstr "Trình đọc"

#: lib/Settings.php
msgid "Reader Time Budget"
msgstr "Quỹ thời gian trình đọc"

#: lib/Settings.php
msgid "Seconds one reader run may spend before it stops starting node reads. Keep it below the poller interval; unread nodes are read on the next run."
msgstr "Số giây một lần chạy trình đọc có thể sử dụng trước khi ngừng bắt đầu đọc nút mới. Giữ giá trị này thấp hơn chu kỳ poller; các nút chưa đọc sẽ được đọc ở lần chạy tiếp theo."

#: lib/Settings.php
msgid "Concurrent Reads"
msgstr "Số lượt đọc đồng thời"

#: lib/Settings.php
msgid "Node reads one reader runs at the same time."
msgstr "Số lượt đọc nút mà một trình đọc thực hiện cùng lúc."

#: lib/Settings.php
msgid "Uninstall"
msgstr "Gỡ cài đặt"

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Giữ các bảng của plugin khi gỡ cài đặt"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin keeps its filesystems, nodes, inventory, and cache. Clear it to have the uninstall drop them; export the registry first from the Parallel Filesystem Admin page. Storage nodes are never contacted either way."
msgstr "Khi được chọn, việc gỡ cài đặt plugin sẽ giữ lại các hệ thống tệp, nút, danh mục và bộ nhớ đệm của nó. Bỏ chọn để quá trình gỡ cài đặt xóa bỏ chúng; hãy xuất sổ đăng ký trước từ trang Quản trị Hệ thống tệp song song. Dù chọn cách nào thì các nút lưu trữ cũng không bao giờ bị kết nối tới."

#: lib/Settings.php
msgid "Delete the Devices This Plugin Created on Uninstall"
msgstr "Xóa các thiết bị do plugin này tạo khi gỡ cài đặt"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin deletes the devices it created for filesystems, with their graphs and data sources, as deleting them in Cacti would. Existing devices that were mapped to a filesystem are never deleted. RRD files are removed only if Cacti's own RRD cleanup setting removes them. Cleared, the devices stay."
msgstr "Khi được chọn, việc gỡ cài đặt plugin sẽ xóa các thiết bị mà nó đã tạo cho hệ thống tệp, cùng với biểu đồ và nguồn dữ liệu của chúng, giống như cách xóa trong Cacti. Các thiết bị hiện có đã được ánh xạ tới hệ thống tệp sẽ không bao giờ bị xóa. Các tệp RRD chỉ bị xóa nếu thiết lập dọn dẹp RRD riêng của Cacti xóa chúng. Nếu bỏ chọn, các thiết bị sẽ được giữ lại."

#: lib/TargetsPage.php
msgid "No filesystem is visible to you."
msgstr "Không có hệ thống tệp nào hiển thị với bạn."

#: lib/TargetsPage.php
#, php-format
msgid "Filesystem %s"
msgstr "Hệ thống tệp %s"

#: lib/TargetsPage.php

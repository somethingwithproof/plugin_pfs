msgstr "Port : saisissez un port compris entre 1 et 65535."

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "Nom de connexion : utilisez un nom de compte en minuscules d'au plus 32 caractères, commençant par une lettre ou un tiret bas."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "Point de terminaison : saisissez uniquement un nom d'hôte ou une adresse IP, sans utilisateur, port ni chemin."

#: lib/NodeInput.php
msgid "Endpoint: the name does not resolve on this server."
msgstr "Point de terminaison : le nom ne se résout pas sur ce serveur."

#: lib/NodeInput.php

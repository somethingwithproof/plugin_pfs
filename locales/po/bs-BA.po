#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Uređaj \"%s\" iz šablona uređaja %s, koji ispituje poller %d, sa isključenim provjerama dostupnosti."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", listing %d targets known now. It creates no graph by itself."
msgstr "Upit podataka \"%s\", koji daje spisak od %d trenutno poznatih ciljeva. Sam po sebi ne kreira nijedan grafikon."

#: lib/DeviceProvisioner.php
#, php-format

msgstr "Bestandssysteem: kies een van de geregistreerde bestandssystemen."

#: lib/NodeInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Naam: gebruik 1 tot 64 letters, cijfers, punten, streepjes of underscores, beginnend met een letter of cijfer."

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "Rol: kies een van de vermelde rollen."

#: lib/NodeInput.php
msgid "Port: enter a port from 1 to 65535."
msgstr "Poort: voer een poort van 1 tot 65535 in."

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "Aanmeldingsnaam: gebruik een accountnaam in kleine letters van maximaal 32 tekens, beginnend met een letter of een onderstrepingsteken."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "Endpoint: voer alleen een hostnaam of IP-adres in, zonder gebruiker, poort of pad."

#: lib/NodeInput.php
msgid "Endpoint: the name does not resolve on this server."
msgstr "Endpoint: de naam kan op deze server niet worden omgezet."


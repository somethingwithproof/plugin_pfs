msgstr "Pangalan sa Pag-login: gumamit ng nakamaliit na titik na pangalan ng account na may hanggang 32 character, na nagsisimula sa isang letra o underscore."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "Endpoint: maglagay lamang ng pangalan ng host o isang IP address, nang walang user, port, o path."


#: lib/Settings.php
msgid "Absolute path to the ssh client on each poller that reads nodes."
msgstr "ኖዶችን በሚያነብ እያንዳንዱ ፖለር ላይ ወደ ssh ደንበኛው የሚወስድ ፍጹም ዱካ።"

#: lib/Settings.php
msgid "SSH Client"
msgstr "SSH ደንበኛ"

#: lib/Settings.php
msgid "Absolute path, on each poller that reads nodes, to the private key whose public half each node lists in authorized_keys with a forced command running pfs-read.sh. Readable only by the poller user. The plugin never creates, copies, or prints it."
msgstr "ኖዶችን በሚያነብ እያንዳንዱ ፖለር ላይ፣ የህዝብ ግማሹን እያንዳንዱ ኖድ pfs-read.sh ን በሚያስኬድ የግዴታ ትዕዛዝ በ authorized_keys ውስጥ ወደሚዘረዝርበት የግል ቁልፍ የሚወስድ ፍጹም ዱካ። በፖለር ተጠቃሚው ብቻ የሚነበብ። ፕለጊኑ በፍጹም አይፈጥረውም፣ አይገለብጠውም ወይም አያትመውም።"

#: lib/Settings.php
msgid "SSH Key File"
msgstr "የ SSH ቁልፍ ፋይል"

#: lib/Settings.php
msgid "Absolute path to the known_hosts file holding each node host key under the node endpoint name. A node whose key is missing or changed is not read."
msgstr "በኖድ መጨረሻ ነጥብ ስም ስር የእያንዳንዱን ኖድ የሆስት ቁልፍ ወደያዘው known_hosts ፋይል የሚወስድ ፍጹም ዱካ። ቁልፉ የጠፋበት ወይም የተቀየረበት ኖድ አይነበብም።"

#: lib/Settings.php
msgid "Known Hosts File"
msgstr "የሚታወቁ ሆስቶች ፋይል"

#: lib/Settings.php
msgid "Connect Timeout"
msgstr "የግንኙነት ጊዜ ማብቂያ"

#: lib/Settings.php
msgid "Seconds to wait for a node to accept the connection."
msgstr "አንድ ኖድ ግንኙነቱን እስኪቀበል የሚጠበቁ ሰከንዶች።"


#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: گره بدون قالب‌بندی ثابت اسکریپت خواندن پاسخ داد. ممکن است کلید آن به یک دستور اجباری برای اجرای pfs-read.sh محدود نشده باشد."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: کلید میزبان گره در فایل میزبان‌های شناخته‌شده نیست یا تغییر کرده است. پیش از افزودن آن، کلید را بررسی کنید."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: نقطه پایانی به خارج از شبکه‌های مجاز برای گردآورنده %d تفکیک می‌شود، بنابراین خوانده نمی‌شود."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: اسکریپت خواندن %d پارامتر چاپ کرد که افزونه آن‌ها را نمی‌خواند، بنابراین همان pfs-read.sh ارائه‌شده نیست. ممکن است گره اطلاعاتی بیش از نیاز افزونه افشا کند."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d نام هدف در خروجی گره با الگوی مورد انتظار یا فایل‌سیستم مطابقت نداشتند و نادیده گرفته شدند."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "خواننده روی گردآورنده %d در %d ثانیه گذشته هیچ اجرایی را کامل نکرده است. مقادیر گره‌های آن در حال کهنه شدن هستند."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "نصب قالب‌های فایل‌سیستم موازی ناموفق بود: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "قالب‌های فایل‌سیستم موازی نصب نشده‌اند، بنابراین هیچ دستگاهی را نمی‌توان افزود."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "فایل پرس‌وجوی داده resource/script_server/%s در Cacti وجود ندارد یا با فایل ارائه‌شده توسط این افزونه متفاوت است، بنابراین پرس‌وجوهای داده نمی‌توانند هدف‌ها را فهرست کنند."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "فایل‌سیستم %s به دستگاه %d نگاشت شده است که دیگر وجود ندارد."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "دستگاه فایل‌سیستم %s توسط گردآورنده %d گردآوری می‌شود، اما گره‌های آن توسط گردآورنده %d خوانده می‌شوند که منابع داده دستگاه به حافظه نهان آن نیاز دارند."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "فایل کلید SSH به نشانی %s روی این سرور وجود ندارد."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "فایل کلید SSH به نشانی %s توسط کاربرانی غیر از مالک آن قابل خواندن یا نوشتن است (حالت %s). دسترسی آن را به کاربر گردآورنده محدود کنید."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "فایل میزبان‌های شناخته‌شده %s روی این سرور وجود ندارد، بنابراین هیچ گره‌ای از آن قابل خواندن نیست."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "کلاینت SSH به نشانی %s روی این سرور وجود ندارد."

#: lib/NodeInput.php

msgstr "Uhlelo lwamafayela lulondoloziwe."

#: pfs_admin.php
msgid "The filesystem, its nodes, and its inventory were deleted. Its Cacti device, data sources, and graphs were kept. No node was contacted."
msgstr "Uhlelo lwamafayela, amanodi alo, nohlu lwalo lwezinto kususwe. Idivayisi yalo ye-Cacti, imithombo yedatha, namagrafu kugcinwe. Alikho inodi elithintiwe."

#: pfs_admin.php
msgid "Name: another node already uses this name."
msgstr "Igama: elinye inodi selivele lisebenzisa leli gama."

#: pfs_admin.php

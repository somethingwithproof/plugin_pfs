#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: edemede ọgụgụ ahụ bipụtara paramita %d nke ngwa mgbakwunye anaghị agụ, ya mere ọ bụghị pfs-read.sh e zitere. Nọdụ ahụ nwere ike ịna-ekpughe ihe karịrị nke ngwa mgbakwunye chọrọ."


msgstr "Još nije pronađeno nijedno odredište."

#: pfs_admin.php
msgid "That record belongs to a Cacti device you do not have permission for. Nothing was changed."
msgstr "Taj zapis pripada uređaju Cacti za koji nemate ovlasti. Ništa nije izmijenjeno."

#: pfs_admin.php
msgid "Name: another filesystem of this backend already uses this name."
msgstr "Ime: drugi datotečni sustav ovog pozadinskog sustava već koristi to ime."

#: pfs_admin.php
msgid "The filesystem could not be saved."
msgstr "Datotečni sustav nije bilo moguće spremiti."

#: pfs_admin.php
msgid "The filesystem was saved."
msgstr "Datotečni sustav je spremljen."

#: pfs_admin.php
msgid "The filesystem, its nodes, and its inventory were deleted. Its Cacti device, data sources, and graphs were kept. No node was contacted."
msgstr "Datotečni sustav, njegovi čvorovi i inventar su izbrisani. Njegov uređaj Cacti, izvori podataka i grafovi su zadržani. Ni s jednim čvorom nije uspostavljena veza."

#: pfs_admin.php
msgid "Name: another node already uses this name."
msgstr "Ime: drugi čvor već koristi to ime."

#: pfs_admin.php
msgid "The node could not be saved."
msgstr "Čvor nije bilo moguće spremiti."

#: pfs_admin.php
msgid "The node was saved."
msgstr "Čvor je spremljen."

#: pfs_admin.php
msgid "The node was deleted. Targets it reported keep their history."
msgstr "Čvor je izbrisan. Odredišta koja je prijavio zadržavaju svoju povijest."

#: pfs_admin.php
msgid "Enter a network as an address and prefix length, such as 10.20.0.0/16."
msgstr "Unesite mrežu kao adresu i duljinu prefiksa, primjerice 10.20.0.0/16."

#: pfs_admin.php
msgid "No device was added: the filesystem already has one, or the templates are not installed."
msgstr "Nijedan uređaj nije dodan: datotečni sustav ga već ima ili predlošci nisu instalirani."

#: pfs_admin.php
msgid "The device could not be mapped. It may be mapped to another filesystem."
msgstr "Uređaj nije bilo moguće pridružiti. Moguće je da je pridružen drugom datotečnom sustavu."

#: pfs_admin.php
msgid "The device was mapped and the data queries and overview graphs were added."
msgstr "Uređaj je pridružen te su dodani upiti podataka i pregledni grafovi."

#: pfs_admin.php
msgid "Cacti did not create the device. See the Cacti log."
msgstr "Cacti nije stvorio uređaj. Pogledajte dnevnik sustava Cacti."

#: pfs_admin.php
msgid "The device, its data queries, and its overview graphs were created."
msgstr "Uređaj, njegovi upiti podataka i pregledni grafovi su stvoreni."

#: pfs_admin.php
msgid "The device is no longer mapped. It and its graphs were kept; its data queries list no targets until it is mapped again."
msgstr "Uređaj više nije pridružen. Uređaj i njegovi grafovi su zadržani; njegovi upiti podataka ne prikazuju odredišta dok se ponovno ne pridruži."

#: pfs_health.php
msgid "The templates and data query files were installed."
msgstr "Predlošci i datoteke upita podataka su instalirani."

#: pfs_health.php
#, php-format
msgid "The templates could not be installed: %s"
msgstr "Predlošci se nisu mogli instalirati: %s"


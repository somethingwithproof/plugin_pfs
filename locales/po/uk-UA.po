#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: вузол відповів без фіксованого обрамлення скрипту зчитування. Можливо, його ключ не обмежений примусовою командою запуску pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: ключ хоста вузла відсутній у файлі відомих хостів або змінився. Перевірте ключ перед додаванням."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: кінцева точка розпізнається за межами мереж, дозволених для опитувача %d, тому вона не зчитується."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: скрипт зчитування вивів %d параметрів, які плагін не читає, отже це не штатний pfs-read.sh. Вузол може розкривати більше даних, ніж потрібно плагіну."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d назв цілей у виводі вузла не відповідали очікуваному шаблону або файловій системі та були проігноровані."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Зчитувач на опитувачі %d не завершував запуск протягом останніх %d секунд. Значення з його вузлів застарівають."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Помилка встановлення шаблонів Паралельної файлової системи: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Шаблони Паралельної файлової системи не встановлено, тому неможливо додати пристрій."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Файл запиту даних resource/script_server/%s відсутній у Cacti або відрізняється від файлу з комплекту цього плагіна, тому запити даних не можуть вивести список цілей."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Файлова система %s прив'язана до пристрою %d, якого більше не існує."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Пристрій файлової системи %s опитується опитувачем %d, але її вузли зчитуються опитувачем %d, кеш якого потрібен джерелам даних пристрою."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Файл ключа SSH %s не існує на цьому сервері."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Файл ключа SSH %s може читатися або змінюватися іншими користувачами, крім власника (права %s). Обмежте доступ лише користувачем опитувача."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Файл відомих хостів %s не існує на цьому сервері, тому жоден вузол не може бути зчитаний із нього."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "Клієнт SSH %s не існує на цьому сервері."

#: lib/NodeInput.php
msgid "Filesystem: choose one of the registered filesystems."
msgstr "Файлова система: виберіть одну із зареєстрованих файлових систем."

#: lib/NodeInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Назва: використовуйте від 1 до 64 літер, цифр, крапок, дефісів або символів підкреслення, починаючи з літери чи цифри."

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "Роль: виберіть одну з перелічених ролей."

#: lib/NodeInput.php
msgid "Port: enter a port from 1 to 65535."
msgstr "Порт: введіть номер порту від 1 до 65535."

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "Ім'я входу: використовуйте ім'я облікового запису в нижньому регістрі довжиною не більше 32 символів, що починається з літери або символу підкреслення."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "Кінцева точка: введіть лише ім'я хоста або IP-адресу, без користувача, порту чи шляху."

#: lib/NodeInput.php
msgid "Endpoint: the name does not resolve on this server."
msgstr "Кінцева точка: ім'я не розпізнається на цьому сервері."

#: lib/NodeInput.php
#, php-format
msgid "Endpoint: it resolves to %s, which is not inside the networks allowed for this poller. Add the network first."
msgstr "Кінцева точка: вона розпізнається як %s, що не входить до мереж, дозволених для цього опитувача. Спочатку додайте мережу."


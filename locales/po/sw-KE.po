#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: nodi ilijibu bila mpangilio maalumu wa hati ya usomaji. Huenda ufunguo wake haujawekewa kikomo cha amri ya lazima inayoendesha pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: ufunguo wa seva pangishi wa nodi haupo katika faili ya known hosts, au ulibadilika. Kagua ufunguo kabla ya kuuongeza."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: ncha inatafsirika nje ya mitandao iliyoruhusiwa kwa poller %d, kwa hivyo haisomwi."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: hati ya usomaji ilichapisha vigezo %d ambavyo programu-jalizi haisomi, kwa hivyo si pfs-read.sh iliyotolewa. Huenda nodi inafichua zaidi ya kile programu-jalizi inachohitaji."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: majina %d ya malengo katika matokeo ya nodi hayakulingana na mtindo au mfumo wa faili unaotarajiwa na yakapuuzwa."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Kisomaji kwenye poller %d hakijakamilisha uendeshaji katika sekunde %d zilizopita. Thamani kutoka nodi zake zinakuwa za zamani."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Kusakinisha violezo vya Parallel Filesystem kumeshindwa: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Violezo vya Parallel Filesystem havijasakinishwa, kwa hivyo hakuna kifaa kinachoweza kuongezwa."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Faili ya hoja ya data resource/script_server/%s haipo katika Cacti au inatofautiana na ile inayotolewa na programu-jalizi hii, kwa hivyo hoja za data haziwezi kuorodhesha malengo."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Mfumo wa faili %s umehusianishwa na kifaa %d, ambacho hakipo tena."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Kifaa cha mfumo wa faili %s kinakusanywa na poller %d, lakini nodi zake zinasomwa na poller %d, ambaye kache yake inahitajika na vyanzo vya data vya kifaa hicho."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Faili ya ufunguo wa SSH %s haipo kwenye seva hii."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Faili ya ufunguo wa SSH %s inaweza kusomwa au kuandikwa na watumiaji wengine mbali na mmiliki wake (hali %s). Iwekee kikomo kwa mtumiaji wa poller pekee."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Faili ya known hosts %s haipo kwenye seva hii, kwa hivyo hakuna nodi inayoweza kusomwa kutoka kwayo."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "Programu-teja ya SSH %s haipo kwenye seva hii."


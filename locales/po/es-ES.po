#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: el nodo respondió sin el formato delimitado del script de lectura fijo. Puede que su clave no esté limitada al comando forzado que ejecuta pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: la clave del host no está en el archivo de hosts conocidos o ha cambiado. Verifíquela antes de añadirla."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: el punto de conexión se resuelve fuera de las redes permitidas para el sondeador %d, por lo que no se lee."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: el script imprimió %d parámetros que el complemento no lee, por lo que no es el pfs-read.sh distribuido. El nodo puede estar exponiendo más información de la necesaria."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: se ignoraron %d nombres de destino de la salida del nodo que no coincidían con el patrón o el sistema de archivos esperado."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "El lector del sondeador %d no ha completado ninguna ejecución en los últimos %d segundos. Los valores de sus nodos están quedando obsoletos."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Falló la instalación de las plantillas de Sistemas de archivos paralelos: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Las plantillas no están instaladas, por lo que no se pueden añadir dispositivos."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "El archivo de consulta resource/script_server/%s falta en Cacti o difiere del distribuido por el complemento; las consultas no pueden enumerar destinos."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "El sistema de archivos %s está asignado al dispositivo %d, que ya no existe."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "El dispositivo del sistema %s usa el sondeador %d, pero sus nodos los lee el sondeador %d, cuya caché necesitan las fuentes de datos del dispositivo."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "El archivo de clave SSH %s no existe en este servidor."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Otros usuarios distintos del propietario pueden leer o escribir el archivo de clave SSH %s (modo %s). Limítelo al usuario del sondeador."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "El archivo de hosts conocidos %s no existe en este servidor, por lo que no se puede leer ningún nodo."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "El cliente SSH %s no existe en este servidor."


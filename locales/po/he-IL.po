msgid "Role: choose one of the listed roles."
msgstr "תפקיד: בחר אחד מהתפקידים הרשומים."

#: lib/NodeInput.php
msgid "Port: enter a port from 1 to 65535."
msgstr "יציאה: הזן יציאה בין 1 ל-65535."

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "שם התחברות: השתמש בשם חשבון באותיות קטנות באורך של עד 32 תווים, המתחיל באות או בקו תחתון."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "נקודת קצה: הזן שם מארח או כתובת IP בלבד, ללא משתמש, יציאה או נתיב."

#: lib/NodeInput.php
msgid "Endpoint: the name does not resolve on this server."
msgstr "נקודת קצה: השם אינו מתורגם לכתובת בשרת זה."

#: lib/NodeInput.php
#, php-format
msgid "Endpoint: it resolves to %s, which is not inside the networks allowed for this poller. Add the network first."
msgstr "נקודת קצה: השם מתורגם ל-%s, שאינה נמצאת בתוך הרשתות המורשות עבור דוגם זה. הוסף את הרשת תחילה."


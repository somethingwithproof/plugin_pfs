#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Uređaj \"%s\" iz predloška uređaja %s, koji obrađuje prikupljač %d, s isključenim provjerama dostupnosti."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", listing %d targets known now. It creates no graph by itself."
msgstr "Upit podataka \"%s\", koji daje popis od %d trenutno poznatih odredišta. Sam po sebi ne stvara nijedan graf."


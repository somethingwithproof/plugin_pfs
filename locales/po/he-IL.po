msgstr "גרפים של מערכת קבצים זו"

#: lib/TargetsPage.php
msgid "Condition"
msgstr "מצב"

#: lib/TargetsPage.php
msgid "Freshness"
msgstr "עדכניות"

#: lib/TargetsPage.php

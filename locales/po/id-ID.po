#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: simpul menjawab tanpa pembingkaian skrip baca tetap. Kuncinya mungkin tidak dibatasi pada perintah paksa yang menjalankan pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: kunci host simpul tidak ada di berkas known hosts, atau telah berubah. Periksa kunci tersebut sebelum menambahkannya."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: titik akhir diresolusi ke luar jaringan yang diizinkan untuk poller %d, sehingga tidak dibaca."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: skrip baca mencetak %d parameter yang tidak dibaca oleh plugin, sehingga skrip tersebut bukan pfs-read.sh bawaan. Simpul mungkin mengekspos lebih dari yang dibutuhkan plugin."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d nama target dalam keluaran simpul tidak cocok dengan pola atau sistem berkas yang diharapkan dan diabaikan."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Pembaca pada poller %d belum menyelesaikan satu eksekusi pun dalam %d detik terakhir. Nilai dari simpulnya mulai usang."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Pemasangan templat Parallel Filesystem gagal: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Templat Parallel Filesystem belum terpasang, sehingga tidak ada perangkat yang dapat ditambahkan."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Berkas kueri data resource/script_server/%s tidak ada di Cacti atau berbeda dari berkas yang disertakan plugin ini, sehingga kueri data tidak dapat mencantumkan target."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Sistem berkas %s dipetakan ke perangkat %d, yang sudah tidak ada."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Perangkat sistem berkas %s di-poll oleh poller %d, tetapi simpulnya dibaca oleh poller %d, yang cache-nya dibutuhkan oleh sumber data perangkat tersebut."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Berkas kunci SSH %s tidak ada di server ini."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Berkas kunci SSH %s dapat dibaca atau ditulis oleh pengguna selain pemiliknya (mode %s). Batasi aksesnya hanya untuk pengguna poller."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Berkas known hosts %s tidak ada di server ini, sehingga tidak ada simpul yang dapat dibaca darinya."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "Klien SSH %s tidak ada di server ini."


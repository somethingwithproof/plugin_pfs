#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: nút đã trả lời mà không có khung định dạng cố định của tập lệnh đọc. Khóa của nút có thể chưa được giới hạn vào lệnh bắt buộc chạy pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: khóa máy chủ của nút không có trong tệp known_hosts hoặc đã thay đổi. Hãy kiểm tra khóa trước khi thêm."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: điểm cuối phân giải ra ngoài các mạng được phép cho poller %d nên không được đọc."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: tập lệnh đọc đã in ra %d tham số mà plugin không đọc, do đó đây không phải là pfs-read.sh đi kèm. Nút có thể đang lộ nhiều thông tin hơn mức plugin cần."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d tên mục tiêu trong đầu ra của nút không khớp với mẫu hoặc hệ thống tệp dự kiến và đã bị bỏ qua."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Trình đọc trên poller %d đã không hoàn tất lần chạy nào trong %d giây qua. Dữ liệu từ các nút của nó đang trở nên cũ."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Cài đặt các mẫu Hệ thống tệp song song thất bại: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Các mẫu Hệ thống tệp song song chưa được cài đặt, nên không thể thêm thiết bị nào."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Tệp truy vấn dữ liệu resource/script_server/%s bị thiếu khỏi Cacti hoặc khác với tệp đi kèm plugin này, nên các truy vấn dữ liệu không thể liệt kê mục tiêu."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Hệ thống tệp %s được ánh xạ tới thiết bị %d, nhưng thiết bị này không còn tồn tại."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Thiết bị của hệ thống tệp %s được thu thập bởi poller %d, nhưng các nút của nó được đọc bởi poller %d, nơi chứa bộ nhớ đệm mà các nguồn dữ liệu của thiết bị cần."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Tệp khóa SSH %s không tồn tại trên máy chủ này."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Tệp khóa SSH %s có thể bị đọc hoặc ghi bởi người dùng khác ngoài chủ sở hữu (chế độ %s). Hãy giới hạn quyền chỉ cho người dùng poller."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Tệp known_hosts %s không tồn tại trên máy chủ này, nên không thể đọc nút nào từ đó."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "Ứng dụng khách SSH %s không tồn tại trên máy chủ này."


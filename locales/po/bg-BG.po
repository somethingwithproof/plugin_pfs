#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: възелът отговори без рамкирането на фиксирания скрипт за четене. Възможно е ключът му да не е ограничен до принудителна команда, стартираща pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: хост ключът на възела липсва във файла с известни хостове или е променен. Проверете ключа, преди да го добавите."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: крайната точка се преобразува до адрес извън разрешените мрежи за полър %d, поради което не се чете."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: скриптът за четене изведе %d параметъра, които плъгинът не чете, следователно не е предоставеният pfs-read.sh. Възелът може да разкрива повече данни, отколкото са нужни на плъгина."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d имена на цели в изхода на възела не съответстват на очаквания шаблон или файлова система и бяха игнорирани."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Четецът на полър %d не е завършил изпълнение през последните %d секунди. Стойностите от неговите възли остаряват."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Инсталирането на шаблоните на Parallel Filesystem е неуспешно: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Шаблоните на Parallel Filesystem не са инсталирани, така че не може да се добави устройство."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Файлът за заявка за данни resource/script_server/%s липсва в Cacti или се различава от предоставения с плъгина, поради което заявките за данни не могат да изброят целите."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Файловата система %s е свързана с устройство %d, което вече не съществува."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Устройството на файловата система %s се анкетира от полър %d, но възлите ѝ се четат от полър %d, чийто кеш е нужен на източниците на данни на устройството."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Файлът с SSH ключ %s не съществува на този сървър."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Файлът с SSH ключ %s може да се чете или записва от потребители, различни от собственика му (права %s). Ограничете достъпа само до потребителя на полъра."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Файлът с известни хостове %s не съществува на този сървър, така че от него не може да бъде прочетен нито един възел."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "SSH клиентът %s не съществува на този сървър."

#: lib/NodeInput.php
msgid "Filesystem: choose one of the registered filesystems."
msgstr "Файлова система: изберете една от регистрираните файлови системи."

#: lib/NodeInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Име: използвайте от 1 до 64 букви, цифри, точки, тирета или долни черти, започващи с буква или цифра."

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "Роля: изберете една от посочените роли."

#: lib/NodeInput.php

msgid "The filesystem could not be saved."
msgstr "Das Dateisystem konnte nicht gespeichert werden."

#: pfs_admin.php
msgid "The filesystem was saved."
msgstr "Das Dateisystem wurde gespeichert."

#: pfs_admin.php
msgid "The filesystem, its nodes, and its inventory were deleted. Its Cacti device, data sources, and graphs were kept. No node was contacted."
msgstr "Das Dateisystem, seine Knoten und sein Inventar wurden gelöscht. Sein Cacti-Gerät, seine Datenquellen und seine Diagramme wurden beibehalten. Es wurde kein Knoten kontaktiert."


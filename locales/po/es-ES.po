msgstr "Segundos que se espera a que un nodo acepte la conexión."

#: lib/Settings.php
msgid "Read Timeout"
msgstr "Tiempo de espera de lectura"

#: lib/Settings.php
msgid "Seconds one node read may take in total before it is stopped and recorded as failed."
msgstr "Segundos máximos para leer un nodo antes de detener la lectura y registrarla como fallida."

#: lib/Settings.php
msgid "KiB one node may return. A larger answer is discarded and recorded as failed."
msgstr "KiB que puede devolver un nodo. Una respuesta mayor se descarta y se registra como fallida."

#: lib/Settings.php

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: namaly tsy nisy ny rafitry ny baikon-tsoratra famakiana raikitra ny teboka. Mety tsy voafetra ho amin'ny baiko voatery mandefa ny pfs-read.sh ny fanalahidiny."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: tsy ao amin'ny rakitra known_hosts ny fanalahidin'ny mpampiantranon'ny teboka, na niova izany. Hamarino ny fanalahidy alohan'ny hanampiana azy."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: ivelan'ny tambajotra nahazoana alalana ho an'ny mpanangona %d ny adiresy vahaolana amin'ny teboka fiafarana, ka tsy vakina izy."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: namoaka mari-pamantarana %d izay tsy vakin'ny plugin ny baikon-tsoratra famakiana, ka tsy ilay pfs-read.sh natolotra izy io. Mety mamoaka mihoatra noho izay ilain'ny plugin ny teboka."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: anarana tanjona %d tao amin'ny vokatra avy amin'ny teboka no tsy nifanaraka tamin'ny lamina na rafitra rakitra andrasana ka tsy noraharahaina."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Ny mpamaky ao amin'ny mpanangona %d dia tsy nahavita fandehanana tao anatin'ny %d segondra farany. Mihamanjary lany daty ny sanda avy amin'ny tebony."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Tsy nahomby ny fametrahana ny lasitra Rafitra rakitra mirazotra: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Tsy tafapetraka ny lasitra Rafitra rakitra mirazotra, ka tsy misy fitaovana azo ampiana."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Tsy hita ao amin'ny Cacti ny rakitra fangatahana angona resource/script_server/%s na tsy mitovy amin'ilay natolotr'ity plugin ity, ka tsy afaka mitanisa tanjona ny fangatahana angona."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Ny rafitra rakitra %s dia mifandray amin'ny fitaovana %d, izay tsy misy intsony."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Ny fitaovan'ny rafitra rakitra %s dia angonin'ny mpanangona %d, nefa vakin'ny mpanangona %d ny tebony, izay ilain'ny loharanon'angon'ny fitaovana ny tahiriny vonjimaika."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Tsy misy ato amin'ity mpizara ity ny rakitra fanalahidy SSH %s."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Ny rakitra fanalahidy SSH %s dia azon'ny mpampiasa hafa ankoatra ny tompony vakina na soratana (maody %s). Fero ho an'ny mpampiasa mpanangona ihany izany."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Tsy misy ato amin'ity mpizara ity ny rakitra known_hosts %s, ka tsy misy teboka azo vakina avy aminy."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "Tsy misy ato amin'ity mpizara ity ny mpanjifa SSH %s."


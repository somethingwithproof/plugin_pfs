#, php-format
msgid "A device \"%s\" from the %s device template, polled by poller %d, with availability checks off."
msgstr "Устройство „%s“ от шаблона за устройство %s, анкетирано от полър %d, с изключени проверки за достъпност."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The data query \"%s\", listing %d targets known now. It creates no graph by itself."
msgstr "Заявката за данни „%s“, изброяваща %d известни към момента цели. Сама по себе си тя не създава графика."


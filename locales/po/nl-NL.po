#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: de node antwoordde zonder de vaste framing van het leesscript. De sleutel is mogelijk niet beperkt tot een geforceerde opdracht die pfs-read.sh uitvoert."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: de hostsleutel van de node staat niet in het bestand met bekende hosts of is gewijzigd. Controleer de sleutel voordat u deze toevoegt."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: het endpoint wordt omgezet naar een adres buiten de netwerken die voor poller %d zijn toegestaan en wordt daarom niet gelezen."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: het leesscript heeft %d parameters uitgevoerd die de plug-in niet leest; het is dus niet het meegeleverde pfs-read.sh. De node geeft mogelijk meer prijs dan de plug-in nodig heeft."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d doelnamen in de uitvoer van de node kwamen niet overeen met het verwachte patroon of bestandssysteem en zijn genegeerd."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "De lezer op poller %d heeft de afgelopen %d seconden geen uitvoering voltooid. Waarden van de bijbehorende nodes raken verouderd."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Installeren van de Parallel Filesystem-sjablonen is mislukt: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "De Parallel Filesystem-sjablonen zijn niet geïnstalleerd, dus er kan geen apparaat worden toegevoegd."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Het gegevensquerybestand resource/script_server/%s ontbreekt in Cacti of wijkt af van het bestand dat deze plug-in meelevert, waardoor de gegevensquery's geen doelen kunnen weergeven."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Bestandssysteem %s is gekoppeld aan apparaat %d, dat niet meer bestaat."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Het apparaat van bestandssysteem %s wordt gepolld door poller %d, maar de nodes ervan worden gelezen door poller %d, waarvan de gegevensbronnen van het apparaat de cache nodig hebben."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Het SSH-sleutelbestand %s bestaat niet op deze server."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Het SSH-sleutelbestand %s kan worden gelezen of beschreven door andere gebruikers dan de eigenaar (modus %s). Beperk de toegang tot de poller-gebruiker."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Het bestand met bekende hosts %s bestaat niet op deze server, dus er kan geen enkele node mee worden gelezen."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "De SSH-client %s bestaat niet op deze server."


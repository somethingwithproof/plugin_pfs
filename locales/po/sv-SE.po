#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: noden svarade utan den fasta inramningen från lässkriptet. Dess nyckel kanske inte är begränsad till ett tvingat kommando som kör pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: nodens värdnyckel finns inte i filen för kända värdar, eller så har den ändrats. Kontrollera nyckeln innan du lägger till den."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: slutpunkten slås upp utanför de nätverk som tillåts för poller %d, så den läses inte."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: lässkriptet skrev ut %d parametrar som insticksprogrammet inte läser, så det är inte den medföljande pfs-read.sh. Noden kan exponera mer än vad insticksprogrammet behöver."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d målnamn i nodens utdata matchade inte det förväntade mönstret eller filsystemet och ignorerades."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Läsaren på poller %d har inte slutfört någon körning under de senaste %d sekunderna. Värden från dess noder börjar bli inaktuella."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Installationen av mallarna för Parallel Filesystem misslyckades: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "Mallarna för Parallel Filesystem är inte installerade, så ingen enhet kan läggas till."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Datafrågefilen resource/script_server/%s saknas i Cacti eller skiljer sig från den som detta insticksprogram levererar, så datafrågorna kan inte lista mål."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Filsystemet %s är kopplat till enhet %d, som inte längre finns."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Enheten för filsystemet %s pollas av poller %d, men dess noder läses av poller %d, vars cache enhetens datakällor behöver."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "SSH-nyckelfilen %s finns inte på denna server."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "SSH-nyckelfilen %s kan läsas eller skrivas av andra användare än dess ägare (rättighetsläge %s). Begränsa den till poller-användaren."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Filen för kända värdar %s finns inte på denna server, så ingen nod kan läsas från den."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "SSH-klienten %s finns inte på denna server."

#: lib/NodeInput.php
msgid "Filesystem: choose one of the registered filesystems."
msgstr "Filsystem: välj ett av de registrerade filsystemen."

#: lib/NodeInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Namn: använd 1 till 64 bokstäver, siffror, punkter, bindestreck eller understreck, och börja med en bokstav eller siffra."

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "Roll: välj en av de listade rollerna."

#: lib/NodeInput.php
msgid "Port: enter a port from 1 to 65535."
msgstr "Port: ange en port från 1 till 65535."

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "Inloggningsnamn: använd ett kontonamn med gemener på högst 32 tecken som börjar med en bokstav eller ett understreck."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "Slutpunkt: ange endast ett värdnamn eller en IP-adress, utan användare, port eller sökväg."

#: lib/NodeInput.php
msgid "Endpoint: the name does not resolve on this server."
msgstr "Slutpunkt: namnet kan inte slås upp på denna server."

#: lib/NodeInput.php
#, php-format
msgid "Endpoint: it resolves to %s, which is not inside the networks allowed for this poller. Add the network first."
msgstr "Slutpunkt: det slås upp till %s, som inte ligger inom de nätverk som tillåts för denna poller. Lägg till nätverket först."


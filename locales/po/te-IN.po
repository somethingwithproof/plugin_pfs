#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: ప్లగిన్ చదవని %d పారామీటర్లను రీడ్ స్క్రిప్ట్ ప్రింట్ చేసింది, కాబట్టి ఇది పంపిణీ చేయబడిన pfs-read.sh కాదు. ప్లగిన్‌కు అవసరమైన దానికంటే ఎక్కువ సమాచారాన్ని నోడ్ బహిర్గతం చేస్తూ ఉండవచ్చు."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: నోడ్ అవుట్‌పుట్‌లోని %d లక్ష్య పేర్లు అంచనా వేసిన నమూనా లేదా ఫైల్‌సిస్టమ్‌తో సరిపోలలేదు మరియు విస్మరించబడ్డాయి."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "పోలర్ %d లోని రీడర్ గత %d సెకన్లలో ఒక రన్ కూడా పూర్తి చేయలేదు. దాని నోడ్‌ల నుండి వచ్చే విలువలు పాతబడిపోతున్నాయి."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "పారలల్ ఫైల్‌సిస్టమ్ టెంప్లేట్లను ఇన్‌స్టాల్ చేయడం విఫలమైంది: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "పారలల్ ఫైల్‌సిస్టమ్ టెంప్లేట్లు ఇన్‌స్టాల్ చేయబడలేదు, కాబట్టి ఏ పరికరాన్ని జోడించలేము."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "డేటా క్వెరీ ఫైల్ resource/script_server/%s Cacti లో లేదు లేదా ఈ ప్లగిన్ పంపిణీ చేసే దానికంటే భిన్నంగా ఉంది, కాబట్టి డేటా క్వెరీలు లక్ష్యాలను జాబితా చేయలేవు."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "ఫైల్‌సిస్టమ్ %s పరికరం %d కు మ్యాప్ చేయబడింది, అది ఇప్పుడు ఉనికిలో లేదు."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "ఫైల్‌సిస్టమ్ %s యొక్క పరికరం పోలర్ %d ద్వారా పోల్ చేయబడుతుంది, కానీ దాని నోడ్‌లు పోలర్ %d ద్వారా చదవబడతాయి, దాని క్యాష్ పరికరం యొక్క డేటా సోర్సులకు అవసరం."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "SSH కీ ఫైల్ %s ఈ సర్వర్‌లో ఉనికిలో లేదు."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "SSH కీ ఫైల్ %s ను దాని యజమాని కాకుండా ఇతర వినియోగదారులు చదవగలరు లేదా వ్రాయగలరు (మోడ్ %s). దానిని పోలర్ వినియోగదారుకు మాత్రమే పరిమితం చేయండి."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "known hosts ఫైల్ %s ఈ సర్వర్‌లో ఉనికిలో లేదు, కాబట్టి దాని నుండి ఏ నోడ్‌ను చదవలేము."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "SSH క్లయింట్ %s ఈ సర్వర్‌లో ఉనికిలో లేదు."

#: lib/NodeInput.php
msgid "Filesystem: choose one of the registered filesystems."
msgstr "ఫైల్‌సిస్టమ్: నమోదు చేయబడిన ఫైల్‌సిస్టమ్‌లలో ఒకదాన్ని ఎంచుకోండి."

#: lib/NodeInput.php
msgid "Name: use 1 to 64 letters, digits, dots, dashes, or underscores, starting with a letter or digit."
msgstr "పేరు: అక్షరం లేదా అంకెతో ప్రారంభమయ్యే 1 నుండి 64 అక్షరాలు, అంకెలు, చుక్కలు, డాష్‌లు లేదా అండర్‌స్కోర్‌లను ఉపయోగించండి."

#: lib/NodeInput.php
msgid "Role: choose one of the listed roles."
msgstr "పాత్ర: జాబితా చేయబడిన పాత్రలలో ఒకదాన్ని ఎంచుకోండి."

#: lib/NodeInput.php
msgid "Port: enter a port from 1 to 65535."
msgstr "పోర్ట్: 1 నుండి 65535 వరకు ఒక పోర్ట్‌ను నమోదు చేయండి."

#: lib/NodeInput.php
msgid "Login Name: use a lower-case account name of at most 32 characters, starting with a letter or underscore."
msgstr "లాగిన్ పేరు: అక్షరం లేదా అండర్‌స్కోర్‌తో ప్రారంభమయ్యే, గరిష్టంగా 32 అక్షరాల లోయర్-కేస్ ఖాతా పేరును ఉపయోగించండి."

#: lib/NodeInput.php
msgid "Endpoint: enter a host name or an IP address only, without a user, port, or path."
msgstr "ఎండ్‌పాయింట్: వినియోగదారు, పోర్ట్ లేదా పాత్ లేకుండా కేవలం హోస్ట్ పేరు లేదా IP చిరునామాను మాత్రమే నమోదు చేయండి."

#: lib/NodeInput.php
msgid "Endpoint: the name does not resolve on this server."
msgstr "ఎండ్‌పాయింట్: ఈ సర్వర్‌లో పేరు రిజాల్వ్ కావడం లేదు."

#: lib/NodeInput.php
#, php-format
msgid "Endpoint: it resolves to %s, which is not inside the networks allowed for this poller. Add the network first."
msgstr "ఎండ్‌పాయింట్: ఇది %s కు రిజాల్వ్ అవుతుంది, ఇది ఈ పోలర్ కోసం అనుమతించబడిన నెట్‌వర్క్‌ల లోపల లేదు. ముందుగా నెట్‌వర్క్‌ను జోడించండి."


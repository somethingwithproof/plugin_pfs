msgstr "Krajnja točka razrješava se izvan mreža dopuštenih za svoj prikupljač"

#: lib/ReadError.php
msgid "The endpoint name does not resolve"
msgstr "Ime krajnje točke ne može se razriješiti"

#: lib/ReadError.php
msgid "The node could not be reached"
msgstr "Čvor nije bio dostupan"

#: lib/ReadError.php

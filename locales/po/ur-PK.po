#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: نوڈ نے مقررہ ریڈ اسکرپٹ فریمنگ کے بغیر جواب دیا۔ ممکن ہے کہ اس کی کلید pfs-read.sh چلانے والی لازمی کمانڈ تک محدود نہ ہو۔"

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: نوڈ کی ہوسٹ کلید known hosts فائل میں موجود نہیں ہے، یا تبدیل ہو گئی ہے۔ اسے شامل کرنے سے پہلے کلید چیک کریں۔"

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: اینڈ پوائنٹ پولر %d کے لیے مجاز نیٹ ورکس سے باہر حل ہوتا ہے، اس لیے اسے پڑھا نہیں جاتا۔"

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: ریڈ اسکرپٹ نے %d ایسے پیرامیٹرز پرنٹ کیے جو پلگ ان نہیں پڑھتا، اس لیے یہ فراہم کردہ pfs-read.sh نہیں ہے۔ ممکن ہے نوڈ پلگ ان کی ضرورت سے زیادہ معلومات ظاہر کر رہا ہو۔"

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: نوڈ آؤٹ پٹ میں %d ٹارگٹ نام متوقع پیٹرن یا فائل سسٹم سے مطابقت نہیں رکھتے تھے اور انہیں نظر انداز کر دیا گیا۔"

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "پولر %d پر موجود ریڈر نے پچھلے %d سیکنڈ میں کوئی رن مکمل نہیں کیا۔ اس کے نوڈز سے حاصل ہونے والی اقدار پرانی ہو رہی ہیں۔"

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "پیرلل فائل سسٹم ٹیمپلیٹس انسٹال کرنا ناکام رہا: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "پیرلل فائل سسٹم ٹیمپلیٹس انسٹال نہیں ہیں، اس لیے کوئی ڈیوائس شامل نہیں کی جا سکتی۔"

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "ڈیٹا کوئری فائل resource/script_server/%s Cacti میں غائب ہے یا اس پلگ ان کے ساتھ فراہم کردہ فائل سے مختلف ہے، اس لیے ڈیٹا کوئریز ٹارگٹس کی فہرست نہیں دکھا سکتیں۔"

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "فائل سسٹم %s ڈیوائس %d سے میپ ہے، جو اب موجود نہیں ہے۔"

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "فائل سسٹم %s کی ڈیوائس پولر %d کے ذریعے پول کی جاتی ہے، لیکن اس کے نوڈز پولر %d کے ذریعے پڑھے جاتے ہیں، جس کے کیشے کی ڈیوائس کے ڈیٹا سورسز کو ضرورت ہوتی ہے۔"

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "SSH کلید فائل %s اس سرور پر موجود نہیں ہے۔"

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "SSH کلید فائل %s کو اس کے مالک کے علاوہ دیگر صارفین پڑھ یا لکھ سکتے ہیں (موڈ %s)۔ اسے صرف پولر صارف تک محدود کریں۔"

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "known hosts فائل %s اس سرور پر موجود نہیں ہے، اس لیے اس سے کوئی نوڈ پڑھا نہیں جا سکتا۔"

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "SSH کلائنٹ %s اس سرور پر موجود نہیں ہے۔"

#: lib/NodeInput.php
msgid "Filesystem: choose one of the registered filesystems."

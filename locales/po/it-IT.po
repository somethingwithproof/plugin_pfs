#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node answered without the fixed read script framing. Its key may not be limited to a forced command running pfs-read.sh."
msgstr "%s: il nodo ha risposto senza il framing fisso dello script di lettura. La sua chiave potrebbe non essere limitata a un comando forzato che esegue pfs-read.sh."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the node host key is not in the known hosts file, or it changed. Check the key before adding it."
msgstr "%s: la chiave host del nodo non si trova nel file degli host noti oppure è cambiata. Verificare la chiave prima di aggiungerla."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the endpoint resolves outside the networks allowed for poller %d, so it is not read."
msgstr "%s: l'endpoint si risolve al di fuori delle reti consentite per il poller %d, quindi non viene letto."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: the read script printed %d parameters the plugin does not read, so it is not the shipped pfs-read.sh. The node may be exposing more than the plugin needs."
msgstr "%s: lo script di lettura ha restituito %d parametri che il plugin non legge, quindi non si tratta del pfs-read.sh fornito. Il nodo potrebbe esporre più informazioni di quanto necessario al plugin."

#: lib/HealthWarnings.php
#, php-format
msgid "%s: %d target names in the node output did not match the expected pattern or filesystem and were ignored."
msgstr "%s: %d nomi di target nell'output del nodo non corrispondevano al modello o al filesystem atteso e sono stati ignorati."

#: lib/HealthWarnings.php
#, php-format
msgid "The reader on poller %d has not completed a run in the last %d seconds. Values from its nodes are getting stale."
msgstr "Il reader sul poller %d non ha completato un'esecuzione negli ultimi %d secondi. I valori provenienti dai suoi nodi stanno diventando obsoleti."

#: lib/HealthWarnings.php
#, php-format
msgid "Installing the Parallel Filesystem templates failed: %s"
msgstr "Installazione dei modelli Parallel Filesystem non riuscita: %s"

#: lib/HealthWarnings.php
msgid "The Parallel Filesystem templates are not installed, so no device can be added."
msgstr "I modelli Parallel Filesystem non sono installati, quindi non è possibile aggiungere alcun dispositivo."

#: lib/HealthWarnings.php
#, php-format
msgid "The data query file resource/script_server/%s is missing from Cacti or differs from the one this plugin ships, so the data queries cannot list targets."
msgstr "Il file della query dati resource/script_server/%s manca in Cacti o differisce da quello fornito da questo plugin, pertanto le query dati non possono elencare i target."

#: lib/HealthWarnings.php
#, php-format
msgid "Filesystem %s is mapped to device %d, which no longer exists."
msgstr "Il filesystem %s è mappato al dispositivo %d, che non esiste più."

#: lib/HealthWarnings.php
#, php-format
msgid "The device of filesystem %s is polled by poller %d, but its nodes are read by poller %d, whose cache the device's data sources need."
msgstr "Il dispositivo del filesystem %s è interrogato dal poller %d, ma i suoi nodi vengono letti dal poller %d, della cui cache le origini dati del dispositivo hanno bisogno."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s does not exist on this server."
msgstr "Il file della chiave SSH %s non esiste su questo server."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH key file %s can be read or written by users other than its owner (mode %s). Limit it to the poller user."
msgstr "Il file della chiave SSH %s può essere letto o scritto da utenti diversi dal proprietario (modalità %s). Limitarne l'accesso all'utente del poller."

#: lib/HealthWarnings.php
#, php-format
msgid "The known hosts file %s does not exist on this server, so no node can be read from it."
msgstr "Il file degli host noti %s non esiste su questo server, quindi non è possibile leggere alcun nodo da esso."

#: lib/HealthWarnings.php
#, php-format
msgid "The SSH client %s does not exist on this server."
msgstr "Il client SSH %s non esiste su questo server."


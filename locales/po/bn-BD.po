#: lib/TargetsPage.php
msgid "Review"
msgstr "পর্যালোচনা"

#: lib/TargetsPage.php
msgid "Source Node"
msgstr "সোর্স নোড"

#: lib/TargetsPage.php
msgid "No targets found yet."
msgstr "এখনও কোনো টার্গেট পাওয়া যায়নি।"

#: pfs_admin.php
msgid "That record belongs to a Cacti device you do not have permission for. Nothing was changed."
msgstr "এই রেকর্ডটি এমন একটি Cacti ডিভাইসের অন্তর্ভুক্ত যার জন্য আপনার অনুমতি নেই। কোনো কিছু পরিবর্তন করা হয়নি।"

#: pfs_admin.php
msgid "Name: another filesystem of this backend already uses this name."
msgstr "নাম: এই ব্যাকএন্ডের অন্য একটি ফাইলসিস্টেম ইতিমধ্যেই এই নামটি ব্যবহার করছে।"

#: pfs_admin.php
msgid "The filesystem could not be saved."
msgstr "ফাইলসিস্টেমটি সংরক্ষণ করা যায়নি।"

#: pfs_admin.php
msgid "The filesystem was saved."
msgstr "ফাইলসিস্টেমটি সংরক্ষণ করা হয়েছে।"

#: pfs_admin.php
msgid "The filesystem, its nodes, and its inventory were deleted. Its Cacti device, data sources, and graphs were kept. No node was contacted."
msgstr "ফাইলসিস্টেম, এর নোড এবং এর ইনভেন্টরি মুছে ফেলা হয়েছে। এর Cacti ডিভাইস, ডেটা সোর্স এবং গ্রাফগুলো রাখা হয়েছে। কোনো নোডের সাথে যোগাযোগ করা হয়নি।"

#: pfs_admin.php
msgid "Name: another node already uses this name."
msgstr "নাম: অন্য একটি নোড ইতিমধ্যেই এই নামটি ব্যবহার করছে।"

#: pfs_admin.php
msgid "The node could not be saved."
msgstr "নোডটি সংরক্ষণ করা যায়নি।"

#: pfs_admin.php
msgid "The node was saved."
msgstr "নোডটি সংরক্ষণ করা হয়েছে।"

#: pfs_admin.php
msgid "The node was deleted. Targets it reported keep their history."
msgstr "নোডটি মুছে ফেলা হয়েছে। এটি যে টার্গেটগুলো রিপোর্ট করেছিল সেগুলোর ইতিহাস সংরক্ষিত আছে।"

#: pfs_admin.php
msgid "Enter a network as an address and prefix length, such as 10.20.0.0/16."
msgstr "ঠিকানা এবং প্রিফিক্স দৈর্ঘ্য হিসেবে একটি নেটওয়ার্ক লিখুন, যেমন 10.20.0.0/16।"

#: pfs_admin.php
msgid "No device was added: the filesystem already has one, or the templates are not installed."
msgstr "কোনো ডিভাইস যোগ করা হয়নি: ফাইলসিস্টেমটিতে ইতিমধ্যেই একটি ডিভাইস রয়েছে, অথবা টেমপ্লেটগুলো ইনস্টল করা নেই।"

#: pfs_admin.php
msgid "The device could not be mapped. It may be mapped to another filesystem."
msgstr "ডিভাইসটি ম্যাপ করা যায়নি। এটি সম্ভবত অন্য কোনো ফাইলসিস্টেমের সাথে ম্যাপ করা আছে।"

#: pfs_admin.php
msgid "The device was mapped and the data queries and overview graphs were added."
msgstr "ডিভাইসটি ম্যাপ করা হয়েছে এবং ডেটা কোয়েরি ও ওভারভিউ গ্রাফগুলো যোগ করা হয়েছে।"

#: pfs_admin.php
msgid "Cacti did not create the device. See the Cacti log."
msgstr "Cacti ডিভাইসটি তৈরি করেনি। Cacti লগ দেখুন।"

#: pfs_admin.php
msgid "The device, its data queries, and its overview graphs were created."
msgstr "ডিভাইস, এর ডেটা কোয়েরি এবং এর ওভারভিউ গ্রাফগুলো তৈরি করা হয়েছে।"

#: pfs_admin.php
msgid "The device is no longer mapped. It and its graphs were kept; its data queries list no targets until it is mapped again."
msgstr "ডিভাইসটি আর ম্যাপ করা নেই। এটি এবং এর গ্রাফগুলো রাখা হয়েছে; পুনরায় ম্যাপ না করা পর্যন্ত এর ডেটা কোয়েরি কোনো টার্গেট তালিকাভুক্ত করবে না।"

#: pfs_health.php
msgid "The templates and data query files were installed."
msgstr "টেমপ্লেট এবং ডেটা কোয়েরি ফাইলগুলো ইনস্টল করা হয়েছে।"

#: pfs_health.php
#, php-format
msgid "The templates could not be installed: %s"
msgstr "টেমপ্লেটগুলো ইনস্টল করা যায়নি: %s"

#: pfs_operator.php
msgid "Monitoring view"
msgstr "মনিটরিং ভিউ"

#: pfs_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "পর্যবেক্ষণগুলো পড়া যায়নি। প্লাগইন লগ পরীক্ষা করতে একজন প্রশাসককে বলুন।"

#: setup.php
#, php-format
msgid "The Parallel Filesystem plugin requires PHP %s or later. This server runs PHP %s, so the plugin was not installed or enabled."
msgstr "Parallel Filesystem প্লাগইনটির জন্য PHP %s বা পরবর্তী সংস্করণ প্রয়োজন। এই সার্ভারে PHP %s চলছে, তাই প্লাগইনটি ইনস্টল বা সক্রিয় করা হয়নি।"

#: setup.php
msgid "The Parallel Filesystem plugin is not enabled."
msgstr "Parallel Filesystem প্লাগইনটি সক্রিয় করা নেই।"

#: setup.php
#, php-format
msgid "The Parallel Filesystem plugin requires PHP %s or later."
msgstr "Parallel Filesystem প্লাগইনটির জন্য PHP %s বা পরবর্তী সংস্করণ প্রয়োজন।"

#: setup.php
msgid "Management"
msgstr "ব্যবস্থাপনা"

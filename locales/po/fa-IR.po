#: lib/ReadError.php
msgid "The node could not be reached"
msgstr "دسترسی به گره برقرار نشد"

#: lib/ReadError.php
msgid "The node host key is unknown or changed"
msgstr "کلید میزبان گره ناشناخته است یا تغییر کرده است"

#: lib/ReadError.php
msgid "The node refused the key"
msgstr "گره کلید را رد کرد"

#: lib/ReadError.php
msgid "The read exceeded its time limit"
msgstr "عملیات خواندن از محدودیت زمانی خود فراتر رفت"

#: lib/ReadError.php
msgid "The response exceeded the size limit"
msgstr "پاسخ از محدودیت اندازه فراتر رفت"

#: lib/ReadError.php
msgid "The read command failed"
msgstr "دستور خواندن با خطا مواجه شد"

#: lib/ReadError.php
msgid "The node did not answer with the fixed read script"
msgstr "گره با اسکریپت خواندن ثابت پاسخ نداد"

#: lib/ReadError.php
msgid "The response ended before the read script finished"
msgstr "پاسخ پیش از پایان اسکریپت خواندن متوقف شد"

#: lib/Settings.php
msgid "Node Access"
msgstr "دسترسی به گره"

#: lib/Settings.php
msgid "Absolute path to the ssh client on each poller that reads nodes."
msgstr "مسیر مطلق کلاینت ssh روی هر گردآورنده‌ای که گره‌ها را می‌خواند."

#: lib/Settings.php
msgid "SSH Client"
msgstr "کلاینت SSH"

#: lib/Settings.php
msgid "Absolute path, on each poller that reads nodes, to the private key whose public half each node lists in authorized_keys with a forced command running pfs-read.sh. Readable only by the poller user. The plugin never creates, copies, or prints it."
msgstr "مسیر مطلق، روی هر گردآورنده‌ای که گره‌ها را می‌خواند، به کلید خصوصی که بخش عمومی آن در authorized_keys هر گره با یک دستور اجباری برای اجرای pfs-read.sh فهرست شده است. تنها توسط کاربر گردآورنده قابل خواندن باشد. افزونه هرگز آن را ایجاد، رونوشت یا چاپ نمی‌کند."

#: lib/Settings.php
msgid "SSH Key File"
msgstr "فایل کلید SSH"

#: lib/Settings.php
msgid "Absolute path to the known_hosts file holding each node host key under the node endpoint name. A node whose key is missing or changed is not read."
msgstr "مسیر مطلق فایل known_hosts که کلید میزبان هر گره را زیر نام نقطه پایانی گره نگه می‌دارد. گره‌ای که کلید آن موجود نباشد یا تغییر کرده باشد خوانده نمی‌شود."

#: lib/Settings.php
msgid "Known Hosts File"
msgstr "فایل میزبان‌های شناخته‌شده"

#: lib/Settings.php
msgid "Connect Timeout"
msgstr "مهلت زمانی اتصال"

#: lib/Settings.php
msgid "Seconds to wait for a node to accept the connection."
msgstr "مدت زمان انتظار بر حسب ثانیه برای پذیرش اتصال توسط یک گره."

#: lib/Settings.php
msgid "Read Timeout"
msgstr "مهلت زمانی خواندن"

#: lib/Settings.php
msgid "Seconds one node read may take in total before it is stopped and recorded as failed."
msgstr "مجموع زمان بر حسب ثانیه که خواندن یک گره می‌تواند طول بکشد پیش از آنکه متوقف و به عنوان ناموفق ثبت شود."

#: lib/Settings.php
msgid "KiB one node may return. A larger answer is discarded and recorded as failed."
msgstr "مقدار KiB که یک گره می‌تواند برگرداند. پاسخ بزرگ‌تر دور ریخته شده و به عنوان ناموفق ثبت می‌شود."

#: lib/Settings.php
msgid "Maximum Response"
msgstr "حداکثر اندازه پاسخ"

#: lib/Settings.php
msgid "Reader"
msgstr "خواننده"

#: lib/Settings.php
msgid "Reader Time Budget"
msgstr "بودجه زمانی خواننده"

#: lib/Settings.php
msgid "Seconds one reader run may spend before it stops starting node reads. Keep it below the poller interval; unread nodes are read on the next run."
msgstr "زمان بر حسب ثانیه که یک اجرای خواننده می‌تواند صرف کند پیش از آنکه آغاز خواندن گره‌های جدید را متوقف کند. آن را کمتر از بازه گردآورنده نگه دارید؛ گره‌های خوانده‌نشده در اجرای بعدی خوانده می‌شوند."

#: lib/Settings.php
msgid "Concurrent Reads"
msgstr "خواندن‌های هم‌زمان"

#: lib/Settings.php
msgid "Node reads one reader runs at the same time."
msgstr "تعداد خواندن‌های گره‌ای که یک خواننده به‌طور هم‌زمان اجرا می‌کند."

#: lib/Settings.php
msgid "Uninstall"
msgstr "حذف نصب"

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "نگهداری جدول‌های افزونه هنگام حذف نصب"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin keeps its filesystems, nodes, inventory, and cache. Clear it to have the uninstall drop them; export the registry first from the Parallel Filesystem Admin page. Storage nodes are never contacted either way."
msgstr "در صورت انتخاب، حذف نصب افزونه فایل‌سیستم‌ها، گره‌ها، فهرست دارایی و حافظه نهان آن را نگه می‌دارد. برای پاک شدن آن‌ها هنگام حذف نصب، این گزینه را بردارید؛ ابتدا دفتر ثبت را از صفحه مدیریت فایل‌سیستم موازی برون‌بری کنید. در هر دو حالت هرگز با گره‌های ذخیره‌سازی ارتباط برقرار نمی‌شود."

#: lib/Settings.php
msgid "Delete the Devices This Plugin Created on Uninstall"
msgstr "حذف دستگاه‌های ایجادشده توسط این افزونه هنگام حذف نصب"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin deletes the devices it created for filesystems, with their graphs and data sources, as deleting them in Cacti would. Existing devices that were mapped to a filesystem are never deleted. RRD files are removed only if Cacti's own RRD cleanup setting removes them. Cleared, the devices stay."
msgstr "در صورت انتخاب، حذف نصب افزونه دستگاه‌هایی را که برای فایل‌سیستم‌ها ایجاد کرده است به همراه نمودارها و منابع داده آن‌ها حذف می‌کند، همان‌طور که حذف آن‌ها در Cacti عمل می‌کند. دستگاه‌های موجودی که به یک فایل‌سیستم نگاشت شده‌اند هرگز حذف نمی‌شوند. فایل‌های RRD تنها در صورتی پاک می‌شوند که تنظیم پاک‌سازی RRD خود Cacti آن‌ها را پاک کند. در صورت برداشتن تیک، دستگاه‌ها باقی می‌مانند."

